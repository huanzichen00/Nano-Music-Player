import { AppIcon } from "components.slint";
import { I18n } from "i18n.slint";

component HomeIconPage inherits Rectangle {
    in property <float> s;
    in property <int> selected;
    in property <int> page;
    callback activated(int);
    background: transparent;
    in property <bool> active: true;
    for item[index] in (root.page == 0 ? [
        {label: "Music", icon: @image-url("../assets/generated/music.png"), tint: #ef990a, full: true},
        {label: "Videos", icon: @image-url("../assets/generated/videos.png"), tint: #187dd9, full: true},
        {label: "Fitness", icon: @image-url("../assets/generated/fitness.png"), tint: #c52527, full: true},
        {label: "Podcasts", icon: @image-url("../assets/generated/podcasts.png"), tint: #9540c6, full: true},
        {label: "Photos", icon: @image-url("../assets/generated/photos.png"), tint: #1c9dcb, full: true},
        {label: "Radio", icon: @image-url("../assets/generated/radio.png"), tint: #596473, full: true},
    ] : [
        {label: "Clock", icon: @image-url("../assets/icons/clock.svg"), tint: #777, full: false},
        {label: "Settings", icon: @image-url("../assets/original/settings.png"), tint: #aaa, full: true},
    ]): AppIcon {
        s: root.s; full-artwork: item.full;
        x: (18px + mod(index, 2) * 112px) * root.s;
        y: (24px + floor(index / 2) * 115px) * root.s;
        label: I18n.tr(item.label); icon: item.icon; tint: item.tint; selected: root.active && root.selected == index;
        clicked => { if root.active { root.activated(index); } }
    }

}

export component HomeView inherits Rectangle {
    in property <float> s;
    in property <int> selected;
    in property <int> page;
    in property <int> page-direction: 1;
    in property <bool> smooth-slides: true;
    in property <bool> navigation-enabled: true;
    private property <bool> animating: true;
    out property <length> page-slide-offset: !root.smooth-slides ? 0px : root.page == 1 ? second-page.x : first-page.x;
    out property <length> page-outgoing-offset: !root.smooth-slides ? 0px : root.page == 1 ? first-page.x : second-page.x;
    callback activated(int);
    callback swipe(bool);
    function place-pages() {
        first-page.x = root.page == 0 ? 0px : -root.width;
        second-page.x = root.page == 1 ? 0px : root.width;
    }
    public function cancel-page-transition() { root.animating = false; root.place-pages(); }
    changed page => { root.animating = root.smooth-slides; root.place-pages(); }
    changed width => { root.cancel-page-transition(); }
    changed smooth-slides => { if !root.smooth-slides { root.cancel-page-transition(); } }
    background: @linear-gradient(155deg, #779487, #334d45 70%, #253a37);
    clip: true;

    Rectangle {
        x: -80px * root.s; y: 170px * root.s; width: 350px * root.s; height: 360px * root.s;
        border-radius: 175px * root.s;
        background: @linear-gradient(180deg, #76948445, #16372b00);
        border-width: 1px * root.s; border-color: #aec1b030;
    }
    gesture := SwipeGestureHandler {
        enabled: root.navigation-enabled;
        handle-swipe-right: true; handle-swipe-left: true;
        swiped => {
            let dx = self.current-position.x - self.pressed-position.x;
            let dy = self.current-position.y - self.pressed-position.y;
            if abs(dx) > 24px * root.s && abs(dx) > 1.5 * abs(dy) {
                if dx < 0px && root.page == 0 { root.swipe(true); }
                else if dx > 0px && root.page == 1 { root.swipe(false); }
            }
        }
        property <length> accumulated-x;
        changed enabled => { self.accumulated-x = 0px; wheel-timeout.stop(); }
        wheel-timeout := Timer { interval: 300ms; running: false; triggered => { gesture.accumulated-x = 0px; self.stop(); } }
        TouchArea {
            scroll-event(event) => {
                if !root.navigation-enabled { return reject; }
                if abs(event.delta-x) > 1.5 * abs(event.delta-y) {
                    // Stop repeated momentum events at a page boundary from
                    // resubmitting the same navigation and resetting selection.
                    if (event.delta-x < 0px && root.page == 1) || (event.delta-x > 0px && root.page == 0) {
                        gesture.accumulated-x = 0px; wheel-timeout.stop(); return accept;
                    }
                    gesture.accumulated-x += event.delta-x;
                    wheel-timeout.start(); wheel-timeout.restart();
                    if abs(gesture.accumulated-x) > 16px * root.s {
                        root.swipe(gesture.accumulated-x < 0px); gesture.accumulated-x = 0px; wheel-timeout.stop();
                    }
                    accept
                } else { gesture.accumulated-x = 0px; wheel-timeout.stop(); reject }
            }
            // Translate native rectangle containers, keeping reusable page roots local.
            first-page := Rectangle {
                x: 0px; y: 0px;
                animate x { duration: root.animating && root.smooth-slides ? 180ms : 0ms; easing: ease-out; } width: parent.width; height: parent.height;
                HomeIconPage {
                    x: 0px; y: 0px; width: parent.width; height: parent.height; s: root.s;
                    page: 0; selected: root.selected; active: root.navigation-enabled && root.page == 0;
                    activated(index) => { root.activated(index); }
                }
            }
            second-page := Rectangle {
                x: root.width; y: 0px;
                animate x { duration: root.animating && root.smooth-slides ? 180ms : 0ms; easing: ease-out; } width: parent.width; height: parent.height;
                HomeIconPage {
                    x: 0px; y: 0px; width: parent.width; height: parent.height; s: root.s;
                    page: 1; selected: root.selected; active: root.navigation-enabled && root.page == 1;
                    activated(index) => { root.activated(index); }
                }
            }
        }
    }
    Rectangle {
        y: 377px * root.s; height: 30px * root.s; background: transparent;
        for page in 2: Rectangle {
            x: (108px + page * 16px) * root.s; y: 5px * root.s;
            width: 6px * root.s; height: self.width; border-radius: self.width / 2;
            background: root.page == page ? white : #fff5;
        }

    }
}
