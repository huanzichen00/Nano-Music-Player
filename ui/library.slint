import { I18n } from "i18n.slint";
export struct LibraryRow { title: string, subtitle: string, chevron: bool, artwork: image, show-artwork: bool, font-family: string }
export struct GeniusRow { title: string, artist: string, path: string }

// Shared with the controller for thumbnail decoding and selection scrolling.
export global ListMetrics {
    out property <float> text-row-height: 48;
    // PDF page 10: 82-pixel rows / 340-pixel LCD width × 240 logical units.
    out property <float> artwork-row-height: 58;
    out property <float> artwork-padding: 1;
}

// Keep horizontal Back recognition outside the list rows so a completed swipe
// is consumed by SwipeGestureHandler instead of activating the pressed row.
component LibraryBackArea inherits SwipeGestureHandler {
    in property <float> s;
    callback back;
    property <length> accumulated-x;
    handle-swipe-right: true;
    swiped => {
        let dx = self.current-position.x - self.pressed-position.x;
        let dy = self.current-position.y - self.pressed-position.y;
        if dx > 24px * root.s && dx > 1.5 * abs(dy) { root.back(); }
    }
    changed enabled => { root.accumulated-x = 0px; wheel-timeout.stop(); }
    wheel-timeout := Timer {
        interval: 500ms; running: false;
        triggered => { root.accumulated-x = 0px; self.stop(); }
    }
    TouchArea {
        enabled: root.enabled;
        scroll-event(event) => {
            if abs(event.delta-x) > 1.5 * abs(event.delta-y) {
                root.accumulated-x = max(0px, root.accumulated-x + event.delta-x);
                wheel-timeout.start(); wheel-timeout.restart();
                if root.accumulated-x > 32px * root.s {
                    root.accumulated-x = 0px; wheel-timeout.stop(); root.back();
                }
                accept
            } else { root.accumulated-x = 0px; wheel-timeout.stop(); reject }
        }
        @children
    }
}

export component LibraryView inherits Rectangle {
    in property <float> s;
    in property <string> text-font-family;
    in property <int> selected;
    in property <bool> search;
    in property <bool> compact-title;
    in property <bool> playlist-list: false;
    in property <bool> playlist-content: false;
    in property <bool> shuffle-list: false;
    private property <int> prefix-count: root.playlist-content ? 2 : root.playlist-list || root.shuffle-list ? 1 : 0;
    out property <length> header-height: ((root.search ? 44px : (root.playlist-list || root.playlist-content ? 32px : 0px)) + (root.shuffle-list ? 32px : 0px)) * root.s;
    callback edit-playlist();
    callback back;
    in property <bool> enabled: true;
    in property <[LibraryRow]> rows;
    in-out property <string> search-text;
    in-out property <length> scroll-y;
    out property <bool> search-focused: input.has-focus;
    out property <length> row-height: (root.rows.length > root.prefix-count && root.rows[root.prefix-count].show-artwork ? ListMetrics.artwork-row-height : ListMetrics.text-row-height) * 1px * root.s;
    callback activated(int);
    callback edited(string);
    public function focus-search() { input.focus(); }
    background: #fff;
    LibraryBackArea {
        x: 0px; y: 0px; width: root.width; height: root.height;
        s: root.s; enabled: root.enabled && !(root.search && input.has-focus);
        back => { root.back(); }
        // Existing list controls are children of the gesture area. Its recognizer
        // defers taps and consumes swipes, so rows/toolbars never activate on Back.
    if root.playlist-list: Rectangle {
        x: 0px; y: 0px; width: root.width; height: 32px * root.s;
        background: root.selected == 0 ? @linear-gradient(180deg, #4794e4, #1666bb) : @linear-gradient(180deg, #f5f7f9, #d4d9df);
        Image { source: @image-url("../assets/icons/music.svg"); colorize: root.selected == 0 ? white : #3c78b1; x: 8px * root.s; y: 8px * root.s; width: 14px * root.s; height: 14px * root.s; }
        Text { x: 28px * root.s; width: parent.width - 40px * root.s; height: parent.height; text: I18n.tr("Add Playlist"); color: root.selected == 0 ? white : #1e69b4; font-size: 12px * root.s; font-weight: 700; vertical-alignment: center; }
        TouchArea { clicked => { if root.enabled { root.activated(0); } } }
    }
    if root.playlist-content: Rectangle {
        x: 0px; y: 0px; width: root.width; height: 32px * root.s;
        background: root.selected == 0 ? @linear-gradient(180deg, #4794e4, #1666bb) : @linear-gradient(180deg, #8badcf, #446b93);
        Rectangle {
            x: 6px * root.s; y: 4px * root.s; width: parent.width - 12px * root.s; height: 24px * root.s;
            background: root.selected == 0 ? @linear-gradient(180deg, #4794e4, #1666bb) : @linear-gradient(180deg, #94b4d6, #4b78a6); border-width: 1px * root.s; border-color: #456383; border-radius: 4px * root.s;
            Text { text: I18n.tr("Edit"); color: white; font-size: 12px * root.s; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { if root.enabled { root.activated(0); } } }
        }
    }
    if root.shuffle-list: Rectangle {
        x: 0px; y: (root.search ? 44px : root.playlist-content ? 32px : 0px) * root.s; width: root.width; height: 32px * root.s;
        background: root.selected == (root.playlist-content ? 1 : 0) ? @linear-gradient(180deg, #4794e4, #1666bb) : white;
        Rectangle { y: parent.height - 1px * root.s; height: 1px * root.s; background: #d5d5d5; }
        Image { source: @image-url("../assets/icons/shuffle.svg"); colorize: root.selected == (root.playlist-content ? 1 : 0) ? white : #6b7d8f; x: 10px * root.s; y: 8px * root.s; width: 18px * root.s; height: 16px * root.s; image-fit: contain; }
        Text { x: 38px * root.s; width: parent.width - 48px * root.s; text: I18n.tr("Shuffle"); color: root.rows.length <= root.prefix-count ? #929292 : root.selected == (root.playlist-content ? 1 : 0) ? white : #111; font-size: 14px * root.s; font-weight: 600; vertical-alignment: center; }
        TouchArea { clicked => { if root.enabled && root.rows.length > root.prefix-count { root.activated(root.playlist-content ? 1 : 0); } } }
    }
    Rectangle {
        visible: root.search;
        x: 6px * root.s; y: 6px * root.s; width: parent.width - 12px * root.s; height: 30px * root.s;
        background: #f7f7f7; border-color: input.has-focus ? #4b96da : #b6bbc0; border-width: 1px * root.s; border-radius: 5px * root.s;
        Image { source: @image-url("../assets/icons/magnifying-glass.svg"); colorize: #999; x: 8px * root.s; y: 8px * root.s; width: 14px * root.s; height: 14px * root.s; }
        input := TextInput {
            enabled: root.enabled && root.search;
            x: 28px * root.s; width: parent.width - 34px * root.s; height: parent.height;
            text <=> root.search-text; font-size: 13px * root.s; color: #222;
            vertical-alignment: center; single-line: true;
            edited => { root.edited(self.text); }
        }
    }
    Flickable {
        y: root.header-height;
        height: root.height - self.y; width: root.width;
        content-height: max(self.height, (root.rows.length - root.prefix-count) * root.row-height);
        content-y <=> root.scroll-y;
        for row[index] in root.rows: Rectangle {
            visible: index >= root.prefix-count;
            y: (index - root.prefix-count) * root.row-height; width: root.width; height: root.row-height;
            background: root.selected == index ? @linear-gradient(180deg, #4794e4, #1666bb) : #fff;
            Rectangle { y: parent.height - 1px * root.s; height: 1px * root.s; background: #d5d5d5; }
            if root.playlist-list: Image {
                x: 8px * root.s; y: (parent.height - 18px * root.s) / 2;
                width: 18px * root.s; height: 18px * root.s;
                source: @image-url("../assets/icons/music.svg");
                colorize: root.selected == index ? white : #6b7d8f;
            }
            if row.show-artwork: Rectangle {
                x: ListMetrics.artwork-padding * 1px * root.s; y: self.x;
                width: parent.height - 2 * self.x; height: self.width; background: #e0e3e6;
                Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: row.artwork.width > 0 ? row.artwork : @image-url("../assets/icons/music.svg"); image-fit: contain; }
            }
            Text {
                x: row.show-artwork ? root.row-height + 6px * root.s : (root.playlist-list ? 34px : 12px) * root.s;
                y: row.subtitle == "" ? 0px : (parent.height - 40px * root.s) / 2;
                width: parent.width - self.x - 25px * root.s; height: row.subtitle == "" ? parent.height : 23px * root.s;
                text: row.title; color: root.selected == index ? white : #111;
                font-family: row.font-family == "" ? root.text-font-family : row.font-family;
                font-size: (root.compact-title ? 13px : 16px) * root.s; font-weight: 600; overflow: elide; vertical-alignment: center;
            }
            if row.subtitle != "": Text {
                x: row.show-artwork ? root.row-height + 6px * root.s : (root.playlist-list ? 34px : 12px) * root.s;
                y: (parent.height - 40px * root.s) / 2 + 23px * root.s;
                width: parent.width - self.x - 25px * root.s; height: 17px * root.s;
                text: row.subtitle; color: root.selected == index ? #e1efff : #929292; font-size: (row.show-artwork ? 13px : 11px) * root.s; overflow: elide;
                font-family: row.font-family == "" ? root.text-font-family : row.font-family;
            }
            if row.chevron: Image {
                x: parent.width - 18px * root.s; y: (parent.height - self.height) / 2; width: 7px * root.s; height: 12px * root.s;
                source: @image-url("../assets/icons/chevron-right.svg"); colorize: root.selected == index ? #fff : #aaa;
            }
            TouchArea { clicked => { root.activated(index); } }
        }
        if root.rows.length <= root.prefix-count: Text {
            width: root.width; height: 160px * root.s;
            text: root.search ? I18n.tr("No matching songs") : root.playlist-content ? I18n.tr("Empty playlist") : I18n.tr("No music yet\nFile → Import Music Folder");
            font-size: 13px * root.s; color: #888; horizontal-alignment: center; vertical-alignment: center;
        }
    }
    }
}
