import { BackScroll } from "back-scroll.slint";
import { ElasticFlickable } from "overscroll.slint";
import { I18n } from "i18n.slint";
import { RatingControl } from "rating.slint";
export struct LibraryRow { title: string, subtitle: string, chevron: bool, artwork: image, show-artwork: bool, icon: int, font-family: string, setting: bool, value: string, toggle: bool, checked: bool }
export struct GeniusRow { title: string, artist: string, path: string }

// Shared with the controller for thumbnail decoding and selection scrolling.
export global ListMetrics {
    out property <float> text-row-height: 48;
    out property <float> setting-row-height: 56;
    // PDF page 10: 82-pixel rows / 340-pixel LCD width × 240 logical units.
    out property <float> artwork-row-height: 58;
    out property <float> artwork-padding: 1;
    out property <float> video-thumbnail-width: 80;
    out property <float> video-thumbnail-height: 45;
    out property <float> video-thumbnail-padding: 6;
}

// Keep horizontal Back recognition outside the list rows so a completed swipe
// is consumed by SwipeGestureHandler instead of activating the pressed row.
component LibraryBackArea inherits SwipeGestureHandler {
    in property <float> s;
    callback back;
    property <length> accumulated-x;
    handle-swipe-right: true;
    swiped => {
        let dx = self.current-position.x - self.pressed-position.x;
        let dy = self.current-position.y - self.pressed-position.y;
        if dx > 24px * root.s && dx > 1.5 * abs(dy) { root.back(); }
    }
    changed enabled => { root.accumulated-x = 0px; wheel-timeout.stop(); }
    wheel-timeout := Timer {
        interval: 500ms; running: false;
        triggered => { root.accumulated-x = 0px; self.stop(); }
    }
    TouchArea {
        enabled: root.enabled;
        scroll-event(event) => {
            if abs(event.delta-x) > 1.5 * abs(event.delta-y) {
                BackScroll.activity();
                if BackScroll.consumed {
                    root.accumulated-x = 0px; wheel-timeout.stop(); return accept;
                }
                root.accumulated-x = max(0px, root.accumulated-x + event.delta-x);
                wheel-timeout.start(); wheel-timeout.restart();
                if root.accumulated-x > 32px * root.s {
                    root.accumulated-x = 0px; wheel-timeout.stop();
                    BackScroll.consumed = true; BackScroll.activity(); root.back();
                }
                accept
            } else { root.accumulated-x = 0px; wheel-timeout.stop(); reject }
        }
        @children
    }
}

export component LibraryView inherits Rectangle {
    in property <int> navigation-generation;
    in property <float> s;
    in property <string> text-font-family;
    in property <int> selected;
    in property <bool> search;
    in property <bool> compact-title;
    in property <bool> fit-settings: false;
    in property <bool> keyboard-navigation;
    in property <bool> playlist-list: false;
    in property <bool> playlist-list-editing: false;
    in property <bool> music-list: false;
    in property <bool> playlist-content: false;
    in property <bool> shuffle-list: false;
    in property <bool> rating-visible;
    in property <bool> rating-enabled;
    in property <int> rating;
    in property <string> rating-title;
    callback rating-changed(int);
    private property <length> rating-header-height: root.rating-visible ? 48px * root.s : 0px;
    private property <int> prefix-count: root.playlist-content || root.playlist-list ? 2 : root.shuffle-list ? 1 : 0;
    out property <length> header-height: root.rating-header-height + (root.search ? 44px : root.playlist-list || root.playlist-content ? 38px : 0px) * root.s + (root.shuffle-list ? root.row-height : 0px);
    callback edit-playlist();
    callback back;
    in property <bool> enabled: true;
    in property <[LibraryRow]> rows;
    in-out property <string> search-text;
    in-out property <length> scroll-y;
    out property <length> overshoot: list-scroll.overshoot;
    out property <bool> search-focused: input.has-focus;
    // Videos starts with an Import action, then artwork rows. Its action must
    // not force the thumbnails and two-line titles into 48-pixel text rows.
    private property <bool> video-list: root.rows.length > 1 && root.rows[1].icon == 9;
    // Keep all desktop Settings entry points visible beneath the title strip.
    private property <float> setting-row-height: root.fit-settings
        ? min(ListMetrics.setting-row-height, root.height / (1px * root.s * max(1, root.rows.length)))
        : ListMetrics.setting-row-height;
    out property <length> row-height: (root.rows.length > 0 && root.rows[0].setting ? root.setting-row-height : root.video-list || (root.rows.length > root.prefix-count && root.rows[root.prefix-count].show-artwork) ? ListMetrics.artwork-row-height : ListMetrics.text-row-height) * 1px * root.s;
    callback activated(int);
    callback edited(string);
    public function focus-search() { input.focus(); }
    background: root.rating-visible ? black : #fff;
    RatingControl {
        x: 0px; y: 0px; width: root.width; height: root.rating-header-height;
        visible: root.rating-visible; enabled: root.enabled && root.rating-enabled;
        s: root.s; title: root.rating-title; value: root.rating;
        changed(value) => { root.rating-changed(value); }
    }
    LibraryBackArea {
        x: 0px; y: root.rating-header-height; width: root.width; height: root.header-height - root.rating-header-height;
        s: root.s; enabled: root.enabled && !(root.search && input.has-focus);
        back => { root.back(); }
        // Header controls keep Back recognition. The list below arbitrates
        // horizontal Back and vertical scrolling in its own single recognizer.
    if root.playlist-list: Rectangle {
        x: 0px; y: 0px; width: root.width; height: 38px * root.s;
        background: @linear-gradient(180deg, #dce4eb, #91a7bb);
        for label[index] in [I18n.tr("Add"), root.playlist-list-editing ? I18n.tr("Done") : I18n.tr("Edit")]: Rectangle {
            x: (5px + index * 120px) * root.s; y: 5px * root.s;
            width: 110px * root.s; height: 28px * root.s;
            background: (root.selected == index && root.keyboard-navigation) ? @linear-gradient(180deg, #79a9cd, #3576a7) : @linear-gradient(180deg, #98b5cb, #427eac);
            border-color: #597c97; border-width: 1px * root.s; border-radius: 5px * root.s;
            Text { text: label; color: white; font-size: 14px * root.s; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { if root.enabled { root.activated(index); } } }
        }
    }
    if root.playlist-content: Rectangle {
        x: 0px; y: 0px; width: root.width; height: 38px * root.s;
        background: root.selected == 0 ? @linear-gradient(180deg, #4794e4, #1666bb) : @linear-gradient(180deg, #8badcf, #446b93);
        Rectangle {
            x: 6px * root.s; y: 5px * root.s; width: parent.width - 12px * root.s; height: 28px * root.s;
            background: root.selected == 0 ? @linear-gradient(180deg, #4794e4, #1666bb) : @linear-gradient(180deg, #94b4d6, #4b78a6); border-width: 1px * root.s; border-color: #456383; border-radius: 4px * root.s;
            Text { text: I18n.tr("Edit"); color: white; font-size: 12px * root.s; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { if root.enabled { root.activated(0); } } }
        }
    }
    if root.shuffle-list: Rectangle {
        x: 0px; y: (root.search ? 44px : root.playlist-content ? 38px : 0px) * root.s; width: root.width; height: root.row-height;
        background: root.rating-visible ? black : (root.selected == (root.playlist-content ? 1 : 0) && root.keyboard-navigation) ? @linear-gradient(180deg, #4794e4, #1666bb) : white;
        Rectangle { y: parent.height - 1px * root.s; height: 1px * root.s; background: root.rating-visible ? #333 : #d5d5d5; }
        Image { source: @image-url("../assets/icons/shuffle.svg"); colorize: root.rating-visible || (root.selected == (root.playlist-content ? 1 : 0) && root.keyboard-navigation) ? white : #6b7d8f; x: 10px * root.s; y: (parent.height - self.height) / 2; width: 18px * root.s; height: 16px * root.s; image-fit: contain; }
        Text { x: 38px * root.s; width: parent.width - 48px * root.s; text: I18n.tr("Shuffle"); color: root.rows.length <= root.prefix-count ? #929292 : root.rating-visible || (root.selected == (root.playlist-content ? 1 : 0) && root.keyboard-navigation) ? white : #111; font-size: 14px * root.s; font-weight: 600; vertical-alignment: center; }
        TouchArea { clicked => { if root.enabled && root.rows.length > root.prefix-count { root.activated(root.playlist-content ? 1 : 0); } } }
    }
    Rectangle {
        visible: root.search;
        x: 6px * root.s; y: 6px * root.s; width: parent.width - 12px * root.s; height: 30px * root.s;
        background: #f7f7f7; border-color: input.has-focus ? #4b96da : #b6bbc0; border-width: 1px * root.s; border-radius: 5px * root.s;
        Image { source: @image-url("../assets/icons/magnifying-glass.svg"); colorize: #999; x: 8px * root.s; y: 8px * root.s; width: 14px * root.s; height: 14px * root.s; }
        input := TextInput {
            enabled: root.enabled && root.search;
            x: 28px * root.s; width: parent.width - 34px * root.s; height: parent.height;
            text <=> root.search-text; font-size: 13px * root.s; color: #222;
            vertical-alignment: center; single-line: true;
            edited => { root.edited(self.text); }
        }
    }
    }
    list-scroll := ElasticFlickable {
        s: root.s; enabled: root.enabled;
        navigation-generation: root.navigation-generation;
        back-enabled: !(root.search && input.has-focus);
        back => { root.back(); }
        y: root.header-height;
        height: root.height - self.y; width: root.width;
        content-height: max(self.height, (root.rows.length - root.prefix-count) * root.row-height);
        content-y <=> root.scroll-y;
        for row[index] in root.rows: Rectangle {
            visible: index >= root.prefix-count;
            y: (index - root.prefix-count) * root.row-height; width: root.width; height: root.row-height;
            background: root.rating-visible ? ((root.selected == index && root.keyboard-navigation) ? #222 : black) : (root.selected == index && root.keyboard-navigation) ? @linear-gradient(180deg, #4794e4, #1666bb) : #fff;
            Rectangle { y: parent.height - 1px * root.s; height: 1px * root.s; background: root.rating-visible ? #333 : #d5d5d5; }
            if row.icon > 0 && row.icon < 8 && !row.show-artwork: Image {
                x: 6px * root.s; y: (parent.height - self.height) / 2;
                width: 26px * root.s; height: 26px * root.s;
                source: row.icon == 1 ? @image-url("../assets/icons/nano/genius.png")
                    : row.icon == 2 ? @image-url("../assets/icons/nano/playlist.png")
                    : row.icon == 3 ? @image-url("../assets/icons/nano/artists.png")
                    : row.icon == 4 ? @image-url("../assets/icons/nano/albums.png")
                    : row.icon == 5 ? @image-url("../assets/icons/nano/songs.png")
                    : row.icon == 6 ? @image-url("../assets/icons/nano/genres.png")
                    : @image-url("../assets/icons/nano/smart-playlist.png");
                colorize: (root.selected == index && root.keyboard-navigation) && row.icon != 4 ? white : transparent;
                image-fit: contain;
            }
            if row.icon == 8: Image {
                x: parent.width - 26px * root.s; y: (parent.height - self.height) / 2;
                width: 20px * root.s; height: 20px * root.s;
                source: @image-url("../assets/icons/nano/speaker.png");
                colorize: (root.selected == index && root.keyboard-navigation) ? white : #555; image-fit: contain;
            }
            if row.show-artwork: Rectangle {
                x: (row.icon == 9 ? ListMetrics.video-thumbnail-padding : ListMetrics.artwork-padding) * 1px * root.s;
                width: row.icon == 9 ? ListMetrics.video-thumbnail-width * 1px * root.s : parent.height - 2 * self.x;
                height: row.icon == 9 ? ListMetrics.video-thumbnail-height * 1px * root.s : self.width;
                y: (parent.height - self.height) / 2;
                background: row.artwork.width > 0 ? #e0e3e6 : @linear-gradient(180deg, #455b71, #101d2b);
                Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: row.artwork; image-fit: contain; }
                if row.artwork.width == 0: Image { x: parent.width * 0.2; y: parent.height * 0.2; width: parent.width * 0.6; height: parent.height * 0.6; source: row.icon == 9 ? @image-url("../assets/generated/videos.png") : @image-url("../assets/icons/nano/songs.png"); colorize: row.icon == 9 ? transparent : #dce6ee; image-fit: contain; }
            }
            if !row.setting: Text {
                x: row.show-artwork ? (row.icon == 9 ? (ListMetrics.video-thumbnail-width + 2 * ListMetrics.video-thumbnail-padding) * 1px * root.s : root.row-height + 6px * root.s) : (row.icon > 0 && row.icon < 8 ? 38px : 8px) * root.s;
                y: row.subtitle == "" ? 0px : (parent.height - 40px * root.s) / 2;
                width: parent.width - self.x - 25px * root.s; height: row.subtitle == "" ? parent.height : 23px * root.s;
                text: row.title; color: root.rating-visible || (root.selected == index && root.keyboard-navigation) ? white : #111;
                font-family: row.font-family == "" ? root.text-font-family : row.font-family;
                font-size: (root.compact-title ? 13px : 16px) * root.s; font-weight: 600; overflow: elide; vertical-alignment: center;
            }
            if !row.setting && row.subtitle != "": Text {
                x: row.show-artwork ? (row.icon == 9 ? (ListMetrics.video-thumbnail-width + 2 * ListMetrics.video-thumbnail-padding) * 1px * root.s : root.row-height + 6px * root.s) : (row.icon > 0 && row.icon < 8 ? 38px : 8px) * root.s;
                y: (parent.height - 40px * root.s) / 2 + 23px * root.s;
                width: parent.width - self.x - 25px * root.s; height: 17px * root.s;
                text: row.subtitle; color: (root.selected == index && root.keyboard-navigation) ? #e1efff : #929292; font-size: (row.show-artwork || root.music-list || root.playlist-list ? 14px : 11px) * root.s; overflow: elide;
                font-family: row.font-family == "" ? root.text-font-family : row.font-family;
            }
            if row.setting: Rectangle {
                background: transparent;
                Text {
                    x: 10px * root.s; y: row.subtitle == "" ? 0px : 5px * root.s;
                    width: parent.width - self.x - (row.toggle ? 56px * root.s : row.value != "" ? setting-value.width + 36px * root.s : 28px * root.s);
                    height: row.subtitle == "" ? parent.height : 22px * root.s;
                    text: row.title; font-size: 14px * root.s; font-weight: 600;
                    font-family: row.font-family == "" ? root.text-font-family : row.font-family;
                    color: root.selected == index && root.keyboard-navigation ? white : #202b35;
                    vertical-alignment: center; overflow: elide;
                }
                setting-value := Text {
                    visible: !row.toggle && row.value != "";
                    x: parent.width - self.width - 25px * root.s; y: 8px * root.s;
                    width: min(self.preferred-width, 96px * root.s); height: 22px * root.s;
                    text: row.value; font-size: 11px * root.s;
                    color: root.selected == index && root.keyboard-navigation ? #edf6ff : #49677f;
                    vertical-alignment: center; horizontal-alignment: right; overflow: elide;
                }
                if row.subtitle != "": Text {
                    x: 10px * root.s; y: 29px * root.s; width: parent.width - 20px * root.s; height: 25px * root.s;
                    text: row.subtitle; font-size: 11px * root.s; wrap: word-wrap; overflow: elide;
                    color: root.selected == index && root.keyboard-navigation ? #e1efff : #667584;
                    font-family: row.font-family == "" ? root.text-font-family : row.font-family;
                }
                if row.toggle: Rectangle {
                    accessible-role: switch;
                    accessible-label: row.title + ". " + row.subtitle;
                    accessible-enabled: root.enabled;
                    accessible-checkable: true;
                    accessible-checked: row.checked;
                    accessible-action-default => { if root.enabled { root.activated(index); } }
                    x: parent.width - 46px * root.s; y: 8px * root.s; width: 36px * root.s; height: 20px * root.s;
                    border-radius: 10px * root.s; border-width: 1px * root.s;
                    border-color: row.checked ? #377d46 : #939da5;
                    background: row.checked ? @linear-gradient(180deg, #75b97d, #429653) : @linear-gradient(180deg, #b4bec6, #d0d7dd);
                    Rectangle {
                        x: (row.checked ? 18px : 2px) * root.s; y: 2px * root.s;
                        width: 16px * root.s; height: 16px * root.s; border-radius: 8px * root.s;
                        background: @linear-gradient(180deg, #fff, #e5e9ed);
                        border-width: 1px * root.s; border-color: #ffffffaa;
                    }
                }
                if row.checked && !row.toggle: Text {
                    x: parent.width - 26px * root.s; width: 18px * root.s; height: parent.height;
                    text: "✓"; font-size: 16px * root.s; font-weight: 700;
                    color: root.selected == index && root.keyboard-navigation ? white : #2675ba;
                    vertical-alignment: center;
                }
            }
            if row.chevron: Image {
                x: parent.width - 18px * root.s; y: (parent.height - self.height) / 2; width: 7px * root.s; height: 12px * root.s;
                source: @image-url("../assets/icons/chevron-right.svg"); colorize: (root.selected == index && root.keyboard-navigation) ? #fff : #aaa;
            }
            TouchArea { clicked => { root.activated(index); } }
        }
        if root.rows.length <= root.prefix-count: Text {
            width: root.width; height: 160px * root.s;
            text: root.search ? I18n.tr("No matching songs") : root.playlist-content ? I18n.tr("Empty playlist") : I18n.tr("No music yet\nFile → Import Music Folder");
            font-size: 13px * root.s; color: #888; horizontal-alignment: center; vertical-alignment: center;
        }
    }
}
