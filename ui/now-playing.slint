import { IconButton, NanoSlider } from "components.slint";

export component NowPlayingView inherits Rectangle {
    in property <float> s;
    in property <int> selected;
    in property <bool> selection-visible;
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <image> artwork;
    in property <float> volume;
    in property <bool> muted;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> duration;
    in property <string> track-count;
    in property <bool> shuffle;
    in property <string> repeat-mode;
    in property <bool> overlay-visible;
    in property <bool> lyrics-visible;
    in property <[string]> lyric-lines;
    in property <int> active-lyric;
    in-out property <length> lyric-scroll-y;
    callback activated(int);
    callback toggle-overlay;
    callback seek-changed(float);
    callback volume-changed(float);
    background: #13141a;

    // The title strip, full-width cover and transport follow the seventh-generation nano.
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: 56px * root.s;
        background: @linear-gradient(180deg, #454650, #292b34 50%, #181a23);
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px * root.s; background: #ffffff15; }
        Text { x: 10px * root.s; y: 3px * root.s; width: parent.width - 20px * root.s; height: 15px * root.s; text: root.has-track ? root.artist : "iPod nano"; color: #e7e8ee; horizontal-alignment: center; font-size: 12px * root.s; font-weight: 600; overflow: elide; }
        Text { x: 8px * root.s; y: 18px * root.s; width: parent.width - 16px * root.s; height: 19px * root.s; text: root.has-track ? root.title : "No song selected"; color: white; horizontal-alignment: center; font-size: 15px * root.s; font-weight: 700; overflow: elide; }
        Text { x: 10px * root.s; y: 37px * root.s; width: parent.width - 20px * root.s; height: 15px * root.s; text: root.has-track ? root.album : "Choose a song from Music"; color: #e7e8ee; horizontal-alignment: center; font-size: 11px * root.s; font-weight: 600; overflow: elide; }
    }
    art := Rectangle {
        y: 56px * root.s; width: root.width; height: root.height - 56px * root.s - 110px * root.s; clip: true;
        background: @linear-gradient(180deg, #30333d, #161820);
        if root.artwork.width > 0: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: root.artwork; image-fit: contain; }
        if root.artwork.width == 0: Image {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 116px * root.s; height: 128px * root.s;
            source: @image-url("../assets/icons/music.svg"); colorize: #dce8f3;
        }
        TouchArea { mouse-cursor: pointer; clicked => { root.toggle-overlay(); } }
        if root.overlay-visible || (root.selection-visible && root.selected >= 4): Rectangle {
            background: root.lyrics-visible ? #151b2e88 : transparent;
            // Playback position sits over the cover, above the secondary controls.
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 60px * root.s; background: @linear-gradient(180deg, #d7daed88, #8a92b655);
                Text { x: 9px * root.s; y: 7px * root.s; width: 54px * root.s; height: 18px * root.s; text: root.elapsed; font-size: 12px * root.s; font-weight: 700; color: white; }
                Text { x: 60px * root.s; y: 3px * root.s; width: parent.width - 120px * root.s; height: 18px * root.s; text: root.track-count; font-size: 11px * root.s; font-weight: 600; horizontal-alignment: center; color: white; }
                Text { x: parent.width - 63px * root.s; y: 7px * root.s; width: 54px * root.s; height: 18px * root.s; text: root.duration; horizontal-alignment: right; font-size: 12px * root.s; font-weight: 700; color: white; }
                NanoSlider { x: 11px * root.s; y: 28px * root.s; width: parent.width - 22px * root.s; s: root.s; handle-size: 13px * root.s; value: root.progress; enabled: root.has-track; changed(value) => { root.seek-changed(value); } }
            }
            Rectangle {
                x: 0px; y: 60px * root.s; width: parent.width; height: 42px * root.s;
                background: @linear-gradient(180deg, #171d3655, #171d3622);
                for control[index] in [
                    {icon: @image-url("../assets/icons/repeat.svg"), action: 5, active: root.repeat-mode != "Off"},
                    {icon: @image-url("../assets/icons/shuffle.svg"), action: 4, active: root.shuffle},
                    {icon: @image-url("../assets/icons/track-list.svg"), action: 6, active: false},
                ]: IconButton {
                    x: index * parent.width / 3; width: parent.width / 3; height: parent.height;
                    s: root.s; flat: true; icon-size: 27px * root.s;
                    selected: root.selection-visible && root.selected == control.action;
                    active: control.active; icon: control.icon;
                    clicked => { root.activated(control.action); }
                }
                if root.repeat-mode == "One": Text { x: 25px * root.s; y: 12px * root.s; width: 10px * root.s; height: 12px * root.s; text: "1"; color: #94eeff; font-size: 8px * root.s; font-weight: 700; horizontal-alignment: center; }
            }
            if root.lyrics-visible: Flickable {
                y: 102px * root.s; height: parent.height - self.y;
                content-height: max(self.height, root.lyric-lines.length * 32px * root.s);
                content-y <=> root.lyric-scroll-y;
                // Taps dismiss the overlay; wheel and touch drags only scroll the lyrics.
                TouchArea { width: art.width; height: max(138px * root.s, root.lyric-lines.length * 32px * root.s); mouse-cursor: pointer; clicked => { root.toggle-overlay(); } }
                for line[index] in root.lyric-lines: Rectangle {
                    y: index * 32px * root.s; width: art.width; height: 32px * root.s;
                    background: root.active-lyric == index ? #ffffff12 : transparent;
                    Text {
                        x: 10px * root.s; width: parent.width - 20px * root.s; height: parent.height;
                        text: line; color: root.active-lyric == index ? white : #eef0f5;
                        font-weight: 600; font-size: 13px * root.s; wrap: word-wrap;
                        horizontal-alignment: left; vertical-alignment: center;
                    }
                }
                if root.lyric-lines.length == 0: Text { x: 10px * root.s; width: art.width - 20px * root.s; height: 110px * root.s; text: "No lyrics available"; font-size: 13px * root.s; color: #eef0f5; horizontal-alignment: center; vertical-alignment: center; }
                animate content-y { duration: 180ms; easing: ease-out; }
            }
        }
    }
    Rectangle {
        y: art.y + art.height; height: root.height - self.y;
        background: @linear-gradient(180deg, #444650 0%, #262936 48%, #131620 51%, #080b13 100%);
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px * root.s; background: #d3d9f466; }
        for separator in 2: Rectangle { x: (separator + 1) * 80px * root.s; y: 7px * root.s; width: 1px * root.s; height: 61px * root.s; background: @linear-gradient(180deg, #ffffff22, #ffffff08); }
        for icon[index] in [@image-url("../assets/icons/previous.svg"), root.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg"), @image-url("../assets/icons/next.svg")]: IconButton {
            x: index * 80px * root.s; y: 3px * root.s; width: 80px * root.s; height: 72px * root.s;
            s: root.s; flat: true; icon-size: (index == 1 ? 39px : 35px) * root.s;
            icon: icon; selected: root.selection-visible && root.selected == index;
            clicked => { root.activated(index); }
        }
        NanoSlider { x: 15px * root.s; y: 80px * root.s; width: 182px * root.s; s: root.s; value: root.muted ? 0 : root.volume; selected: root.selection-visible && root.selected == 3; changed(value) => { root.volume-changed(value); } }
        Image { x: 211px * root.s; y: 83px * root.s; width: 18px * root.s; height: 18px * root.s; source: root.muted ? @image-url("../assets/icons/volume-xmark.svg") : @image-url("../assets/icons/volume-high.svg"); colorize: #a6e8ff; image-fit: contain; TouchArea { mouse-cursor: pointer; clicked => { root.activated(3); } } }
    }
}
