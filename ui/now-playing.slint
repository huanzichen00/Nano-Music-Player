import { IconButton, NanoSlider } from "components.slint";
import { I18n } from "i18n.slint";

// Wrap only artwork/text, keeping seek and volume drags outside the recognizer.
component PlaybackBackArea inherits SwipeGestureHandler {
    in property <float> s;
    callback back;
    property <length> accumulated-x;
    handle-swipe-right: true;
    swiped => {
        let dx = self.current-position.x - self.pressed-position.x;
        let dy = self.current-position.y - self.pressed-position.y;
        if dx > 24px * root.s && dx > 1.5 * abs(dy) { root.back(); }
    }
    changed enabled => { root.accumulated-x = 0px; wheel-timeout.stop(); }
    wheel-timeout := Timer {
        interval: 500ms; running: false;
        triggered => { root.accumulated-x = 0px; self.stop(); }
    }
    TouchArea {
        enabled: root.enabled;
        scroll-event(event) => {
            if abs(event.delta-x) > 1.5 * abs(event.delta-y) {
                root.accumulated-x = max(0px, root.accumulated-x + event.delta-x);
                wheel-timeout.start(); wheel-timeout.restart();
                if root.accumulated-x > 32px * root.s {
                    root.accumulated-x = 0px; wheel-timeout.stop(); root.back();
                }
                accept
            } else { root.accumulated-x = 0px; wheel-timeout.stop(); reject }
        }
        @children
    }
}

export component NowPlayingView inherits Rectangle {
    in property <float> s;
    in property <bool> navigation-enabled: true;
    in property <int> selected;
    in property <bool> selection-visible;
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> title;
    in property <string> artist;
    in property <string> album;
    in property <image> artwork;
    in property <float> volume;
    in property <bool> muted;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> duration;
    in property <string> track-count;
    in property <bool> shuffle;
    in property <string> repeat-mode;
    in property <bool> overlay-visible;
    in property <bool> lyrics-visible;
    in property <[string]> lyric-lines;
    in property <[string]> romaji-lines;
    in property <bool> romaji-visible;
    in property <[string]> translated-lines;
    in property <bool> translation-visible;
    in property <int> active-lyric;
    in-out property <length> lyric-scroll-y;
    out property <length> lyric-content-height: 0px;
    callback activated(int);
    callback toggle-overlay;
    callback genius-requested;
    callback seek-changed(float);
    callback volume-changed(float);
    callback back;
    background: #13141a;

    // The title strip, full-width cover and transport follow the seventh-generation nano.
    PlaybackBackArea {
        x: 0px; y: 0px; width: root.width; height: 56px * root.s;
        s: root.s; enabled: root.navigation-enabled;
        back => { root.back(); }
        Rectangle {
            background: @linear-gradient(180deg, #454650, #292b34 50%, #181a23);
            Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px * root.s; background: #ffffff15; }
            Text { x: 10px * root.s; y: 3px * root.s; width: parent.width - 20px * root.s; height: 15px * root.s; text: root.has-track ? root.artist : "iPod nano"; color: #e7e8ee; horizontal-alignment: center; font-size: 12px * root.s; font-weight: 600; overflow: elide; }
            Text { x: 8px * root.s; y: 18px * root.s; width: parent.width - 16px * root.s; height: 19px * root.s; text: root.has-track ? root.title : I18n.tr("No song selected"); color: white; horizontal-alignment: center; font-size: 15px * root.s; font-weight: 700; overflow: elide; }
            Text { x: 10px * root.s; y: 37px * root.s; width: parent.width - 20px * root.s; height: 15px * root.s; text: root.has-track ? root.album : I18n.tr("Choose a song from Music"); color: #e7e8ee; horizontal-alignment: center; font-size: 11px * root.s; font-weight: 600; overflow: elide; }
        }
    }
    art := Rectangle {
        y: 56px * root.s; width: root.width; height: root.height - 56px * root.s - 110px * root.s; clip: true;
        background: @linear-gradient(180deg, #30333d, #161820);
        if root.artwork.width > 0: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: root.artwork; image-fit: contain; }
        if root.artwork.width == 0: Image {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 116px * root.s; height: 128px * root.s;
            source: @image-url("../assets/icons/music.svg"); colorize: #dce8f3;
        }
        PlaybackBackArea {
            s: root.s; enabled: root.navigation-enabled;
            back => { root.back(); }
            TouchArea { clicked => { root.toggle-overlay(); } }
        }
        if root.overlay-visible || (root.selection-visible && root.selected >= 4): Rectangle {
            background: root.lyrics-visible ? #151b2e88 : transparent;
            // Playback position sits over the cover, above the secondary controls.
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: 60px * root.s; background: @linear-gradient(180deg, #d7daed88, #8a92b655);
                Text { x: 9px * root.s; y: 7px * root.s; width: 54px * root.s; height: 18px * root.s; text: root.elapsed; font-size: 12px * root.s; font-weight: 700; color: white; }
                Text { x: 60px * root.s; y: 3px * root.s; width: parent.width - 120px * root.s; height: 18px * root.s; text: root.track-count; font-size: 11px * root.s; font-weight: 600; horizontal-alignment: center; color: white; }
                Text { x: parent.width - 63px * root.s; y: 7px * root.s; width: 54px * root.s; height: 18px * root.s; text: root.duration; horizontal-alignment: right; font-size: 12px * root.s; font-weight: 700; color: white; }
                NanoSlider { x: 11px * root.s; y: 28px * root.s; width: parent.width - 22px * root.s; s: root.s; handle-size: 13px * root.s; value: root.progress; enabled: root.has-track; changed(value) => { root.seek-changed(value); } }
            }
            Rectangle {
                x: 0px; y: 60px * root.s; width: parent.width; height: 42px * root.s;
                background: @linear-gradient(180deg, #171d3655, #171d3622);
                for control[index] in [
                    {icon: @image-url("../assets/icons/repeat.svg"), action: 5, active: root.repeat-mode != "Off"},
                    {icon: @image-url("assets/genius.svg"), action: 7, active: false},
                    {icon: @image-url("../assets/icons/shuffle.svg"), action: 4, active: root.shuffle},
                    {icon: @image-url("../assets/icons/track-list.svg"), action: 6, active: false},
                ]: IconButton {
                    x: index * parent.width / 4; width: parent.width / 4; height: parent.height;
                    s: root.s; flat: true; icon-size: 27px * root.s;
                    selected: root.selection-visible && root.selected == control.action;
                    active: control.active; icon: control.icon;
                    clicked => { if control.action == 7 { root.genius-requested(); } else { root.activated(control.action); } }
                }
                if root.repeat-mode == "One": Text { x: 15px * root.s; y: 12px * root.s; width: 10px * root.s; height: 12px * root.s; text: "1"; color: #94eeff; font-size: 8px * root.s; font-weight: 700; horizontal-alignment: center; }
            }
            if root.lyrics-visible: PlaybackBackArea {
                y: 102px * root.s; height: parent.height - self.y;
                s: root.s; enabled: root.navigation-enabled;
                back => { root.back(); }
                lyrics-scroll := Flickable {
                    content-height: max(self.height, words.preferred-height);
                    content-y <=> root.lyric-scroll-y;
                    // Taps dismiss the overlay; vertical gestures scroll and rightward gestures return Back.
                    TouchArea { x: 0px; y: 0px; width: art.width; height: max(138px * root.s, words.preferred-height); clicked => { root.toggle-overlay(); } }
                    words := VerticalLayout {
                        x: 0px; y: 0px; width: art.width; height: self.preferred-height; spacing: 0px; padding: 0px;
                        changed preferred-height => { root.lyric-content-height = self.preferred-height; }
                        for line[index] in root.lyric-lines: Rectangle {
                            property <string> romaji: root.romaji-visible && index < root.romaji-lines.length ? root.romaji-lines[index] : "";
                            property <string> translation: root.translation-visible && index < root.translated-lines.length ? root.translated-lines[index] : "";
                            min-height: max(32px * root.s, lyric-text.preferred-height + (self.translation != "" ? translation-text.preferred-height + 3px * root.s : 0px) + (self.romaji != "" ? romaji-text.preferred-height + 3px * root.s : 0px) + 10px * root.s);
                            property <bool> active: root.active-lyric == index;
                            changed active => { if self.active { root.lyric-scroll-y = max(min(0px, lyrics-scroll.height - words.preferred-height), min(0px, 32px * root.s - self.y)); } }
                            changed y => { if self.active { root.lyric-scroll-y = max(min(0px, lyrics-scroll.height - words.preferred-height), min(0px, 32px * root.s - self.y)); } }
                            background: self.active ? #ffffff18 : transparent;
                            lyric-text := Text {
                                x: 10px * root.s; y: 5px * root.s; width: parent.width - 20px * root.s;
                                text: line; color: parent.active ? white : #eef0f5;
                                font-weight: parent.active ? 700 : 600; font-size: 13px * root.s; wrap: word-wrap;
                                horizontal-alignment: left;
                            }
                            translation-text := Text {
                                visible: parent.translation != "";
                                x: 10px * root.s; y: lyric-text.y + lyric-text.preferred-height + 3px * root.s;
                                width: parent.width - 20px * root.s;
                                text: parent.translation; color: parent.active ? #ffe4ad : #f0d5a4;
                                font-weight: parent.active ? 600 : 400; font-size: 11px * root.s; wrap: word-wrap;
                                horizontal-alignment: left;
                            }
                            romaji-text := Text {
                                visible: parent.romaji != "";
                                x: 10px * root.s; y: translation-text.y + (parent.translation != "" ? translation-text.preferred-height + 3px * root.s : 0px);
                                width: parent.width - 20px * root.s;
                                text: parent.romaji; color: parent.active ? #c9ecff : #d0d8e7;
                                font-weight: parent.active ? 600 : 400; font-size: 10px * root.s; wrap: word-wrap;
                                horizontal-alignment: left;
                            }
                            TouchArea { clicked => { root.toggle-overlay(); } }
                        }
                    }
                    if root.lyric-lines.length == 0: Text { x: 10px * root.s; width: art.width - 20px * root.s; height: 110px * root.s; text: I18n.tr("No lyrics available"); font-size: 13px * root.s; color: #eef0f5; horizontal-alignment: center; vertical-alignment: center; }
                    animate content-y { duration: 180ms; easing: ease-out; }
                }
            }
        }
    }
    Rectangle {
        y: art.y + art.height; height: root.height - self.y;
        background: @linear-gradient(180deg, #444650 0%, #262936 48%, #131620 51%, #080b13 100%);
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px * root.s; background: #d3d9f466; }
        for separator in 2: Rectangle { x: (separator + 1) * 80px * root.s; y: 7px * root.s; width: 1px * root.s; height: 61px * root.s; background: @linear-gradient(180deg, #ffffff22, #ffffff08); }
        for icon[index] in [@image-url("../assets/icons/previous.svg"), root.playing ? @image-url("../assets/icons/pause.svg") : @image-url("../assets/icons/play.svg"), @image-url("../assets/icons/next.svg")]: IconButton {
            x: index * 80px * root.s; y: 3px * root.s; width: 80px * root.s; height: 72px * root.s;
            s: root.s; flat: true; icon-size: (index == 1 ? 39px : 35px) * root.s;
            icon: icon; selected: root.selection-visible && root.selected == index;
            clicked => { root.activated(index); }
        }
        NanoSlider { x: 15px * root.s; y: 80px * root.s; width: 182px * root.s; s: root.s; value: root.muted ? 0 : root.volume; selected: root.selection-visible && root.selected == 3; changed(value) => { root.volume-changed(value); } }
        Image { x: 211px * root.s; y: 83px * root.s; width: 18px * root.s; height: 18px * root.s; source: root.muted ? @image-url("../assets/icons/volume-xmark.svg") : @image-url("../assets/icons/volume-high.svg"); colorize: #a6e8ff; image-fit: contain; TouchArea { clicked => { root.activated(3); } } }
    }
}
