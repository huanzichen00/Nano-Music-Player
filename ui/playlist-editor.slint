import { NanoActionButton } from "components.slint";
import { I18n } from "i18n.slint";

export struct PlaylistCandidate { id: string, title: string, artist: string, selected: bool }

export component PlaylistEditor inherits Rectangle {
    in property <float> s: 1;
    in property <bool> open;
    in property <bool> editing;
    private property <string> pending-remove;
    in property <[PlaylistCandidate]> candidates;
    in property <[PlaylistCandidate]> draft;
    in property <string> message;
    in property <bool> persisted;
    in property <bool> library-loading;
    in property <bool> saving;
    in-out property <string> name;
    out property <bool> name-focused: name-input.has-focus;
    out property <bool> reviewing: review;
    private property <bool> review;
    private property <int> selected-row;
    private property <string> instruction: root.message != "Draft only · not saved" && root.message != "Changes not saved" ? root.message
        : root.editing ? "Done saves changes; Cancel discards"
        : root.review ? "Create saves this playlist"
        : root.draft.length == 0 ? "Select songs, then Review" : "Review, then Create to save";
    callback command(string, string);
    public function focus-name() { name-input.focus(); }
    public function reset-view() { root.review = false; root.pending-remove = ""; root.selected-row = 0; candidate-scroll.content-y = 0px; draft-scroll.content-y = 0px; }
    public function show-review() { root.review = true; root.pending-remove = ""; root.selected-row = 0; }
    public function review-draft() {
        if (root.editing || root.draft.length > 0) && !root.saving {
            root.command("review", "");
            if root.name != "" { root.show-review(); }
        }
    }
    public function back-to-selection() { root.review = false; root.pending-remove = ""; root.selected-row = 0; }
    public function move-selection(delta: int) {
        root.selected-row = clamp(root.selected-row + delta, 0, max(0, (root.review ? root.draft.length : root.candidates.length) - 1));
    }
    public function toggle-selection() {
        if !root.review && root.selected-row < root.candidates.length { root.command("toggle", root.candidates[root.selected-row].id); }
    }
    changed selected-row => {
        if root.review {
            draft-scroll.content-y = min(0px, clamp(draft-scroll.content-y, -root.selected-row * 48px * root.s, draft-scroll.height - (root.selected-row + 1) * 48px * root.s));
        } else {
            candidate-scroll.content-y = min(0px, clamp(candidate-scroll.content-y, -root.selected-row * 48px * root.s, candidate-scroll.height - (root.selected-row + 1) * 48px * root.s));
        }
    }
    visible: root.open; background: #f4f5f6;
    TouchArea {}
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: 32px * root.s;
        background: @linear-gradient(180deg, #f1f2f3, #aeb3b8);
        Text { x: 68px * root.s; width: parent.width - 78px * root.s; text: root.editing && root.review ? root.name : I18n.tr(root.review ? "Review Playlist" : root.editing ? "Edit Playlist" : "New Playlist"); color: #252a30; font-size: 14px * root.s; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        Text { x: 6px * root.s; width: 56px * root.s; text: I18n.tr("Cancel"); color: #286dac; font-size: 11px * root.s; vertical-alignment: center; overflow: elide; TouchArea { clicked => { root.command("cancel", ""); } } }
    }
    Rectangle {
        visible: !root.review;
        x: 0px; y: 32px * root.s; width: root.width; height: 101px * root.s;
        Text { x: 10px * root.s; y: 9px * root.s; width: parent.width - 20px * root.s; height: 18px * root.s; text: I18n.tr("Playlist Name"); color: #647181; font-size: 11px * root.s; }
        Rectangle {
            x: 10px * root.s; y: 33px * root.s; width: parent.width - 20px * root.s; height: 32px * root.s;
            background: white; border-color: name-input.has-focus ? #4b96da : #b6bbc0; border-width: 1px * root.s; border-radius: 4px * root.s;
            if root.name == "": Text { x: 8px * root.s; width: parent.width - 16px * root.s; text: I18n.tr("Name (optional)"); font-size: 12px * root.s; color: #8793a0; vertical-alignment: center; }
            name-input := TextInput { enabled: root.open && !root.review && !root.saving; x: 8px * root.s; width: parent.width - 16px * root.s; text <=> root.name; font-size: 12px * root.s; color: #263441; single-line: true; vertical-alignment: center; }
        }
        Text { x: 10px * root.s; y: 75px * root.s; width: parent.width - 20px * root.s; height: 20px * root.s; text: I18n.tr("Choose Songs") + " · " + root.draft.length; font-size: 11px * root.s; color: #49637c; vertical-alignment: center; }
    }
    if root.editing && root.review: Rectangle {
        x: 0px; y: 32px * root.s; width: root.width; height: 32px * root.s;
        background: @linear-gradient(180deg, #8badcf, #446b93);
        NanoActionButton { x: 6px * root.s; y: 4px * root.s; width: 108px * root.s; height: 24px * root.s; s: root.s; primary: true; label: root.saving ? "Saving…" : "Done"; enabled: !root.saving && root.name != ""; clicked => { root.command("create", ""); } }
        NanoActionButton { x: 126px * root.s; y: 4px * root.s; width: 108px * root.s; height: 24px * root.s; s: root.s; primary: true; label: "Add"; enabled: !root.saving; clicked => { root.back-to-selection(); root.focus-name(); } }
    }
    if root.review && !root.editing: Rectangle {
        x: 0px; y: 32px * root.s; width: root.width; height: 65px * root.s;
        Text { x: 10px * root.s; y: 8px * root.s; width: parent.width - 20px * root.s; height: 22px * root.s; text: root.name; color: #263441; font-size: 14px * root.s; font-weight: 700; overflow: elide; }
        Text { x: 10px * root.s; y: 35px * root.s; width: parent.width - 20px * root.s; height: 20px * root.s; text: root.draft.length + I18n.tr(" songs"); color: #49637c; font-size: 10px * root.s; vertical-alignment: center; }
    }
    candidate-scroll := Flickable {
        visible: !root.review; x: 0px; y: 133px * root.s; width: root.width; height: root.height - self.y - 70px * root.s;
        content-height: max(self.height, root.candidates.length * 48px * root.s);
        for song[index] in root.candidates: Rectangle {
            x: 0px; y: index * 48px * root.s; width: root.width; height: 48px * root.s;
            background: root.selected-row == index && !root.name-focused ? @linear-gradient(180deg, #4794e4, #1666bb) : white;
            Rectangle { x: 0px; y: parent.height - 1px * root.s; width: root.width; height: 1px * root.s; background: #d5d5d5; }
            Rectangle { x: 10px * root.s; y: 15px * root.s; width: 18px * root.s; height: self.width; border-radius: 3px * root.s; border-width: 1px * root.s; border-color: #93a4b5; background: song.selected ? #3183cc : #f5f8fb; Text { text: song.selected ? "✓" : ""; color: white; font-size: 13px * root.s; horizontal-alignment: center; vertical-alignment: center; } }
            Text { x: 38px * root.s; y: 5px * root.s; width: parent.width - 48px * root.s; height: 22px * root.s; text: song.title; font-size: 13px * root.s; font-weight: 600; color: root.selected-row == index && !root.name-focused ? white : #263441; overflow: elide; }
            Text { x: 38px * root.s; y: 28px * root.s; width: parent.width - 48px * root.s; height: 16px * root.s; text: song.artist; font-size: 11px * root.s; color: root.selected-row == index && !root.name-focused ? #e1efff : #929292; overflow: elide; }
            TouchArea { clicked => { if !root.saving && !root.library-loading { root.selected-row = index; root.command("toggle", song.id); } } }
        }
        if root.candidates.length == 0: Text { x: 16px * root.s; width: root.width - 32px * root.s; height: 170px * root.s; text: I18n.tr(root.library-loading ? "Loading music library…" : "Import music to choose songs."); color: #788390; font-size: 12px * root.s; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
    }
    draft-scroll := Flickable {
        visible: root.review; x: 0px; y: (root.editing ? 64px : 97px) * root.s; width: root.width; height: root.height - self.y - (root.editing ? 64px : 112px) * root.s;
        content-height: max(self.height, root.draft.length * 48px * root.s);
        for song[index] in root.draft: Rectangle {
            x: 0px; y: index * 48px * root.s; width: root.width; height: 48px * root.s;
            background: root.selected-row == index ? @linear-gradient(180deg, #4794e4, #1666bb) : white;
            Rectangle { x: 0px; y: parent.height - 1px * root.s; width: root.width; height: 1px * root.s; background: #d5d5d5; }
            if !root.editing: Text { x: 9px * root.s; width: 20px * root.s; text: index + 1; font-size: 11px * root.s; color: root.selected-row == index ? #e1efff : #93a0ae; vertical-alignment: center; }
            Text { x: 34px * root.s; y: 5px * root.s; width: parent.width - (root.editing ? (root.pending-remove == song.id ? 104px : 64px) : 44px) * root.s; height: 22px * root.s; text: song.title; font-size: 13px * root.s; font-weight: 600; color: root.selected-row == index ? white : #263441; overflow: elide; }
            Text { x: 34px * root.s; y: 28px * root.s; width: parent.width - (root.editing ? (root.pending-remove == song.id ? 104px : 64px) : 44px) * root.s; height: 16px * root.s; text: song.artist; font-size: 11px * root.s; color: root.selected-row == index ? #e1efff : #929292; overflow: elide; }
            TouchArea { clicked => { root.selected-row = index; } }
            if root.editing: Rectangle {
                x: 8px * root.s; y: 16px * root.s; width: 17px * root.s; height: self.width;
                Image { source: @image-url("../assets/icons/playlist-remove.svg"); image-fit: contain; width: parent.width; height: parent.height; }
                TouchArea { clicked => { if !root.saving { root.selected-row = index; root.pending-remove = root.pending-remove == song.id ? "" : song.id; } } }
            }
            if root.editing && root.pending-remove != song.id: Text { x: parent.width - 22px * root.s; width: 17px * root.s; text: "≡"; color: #a5a9ae; font-size: 18px * root.s; vertical-alignment: center; }
            if root.editing && root.pending-remove == song.id: Rectangle {
                x: parent.width - 65px * root.s; y: 10px * root.s; width: 60px * root.s; height: 28px * root.s;
                border-radius: 4px * root.s; border-width: 1px * root.s; border-color: #9a2727; background: @linear-gradient(180deg, #e88876, #b72c22);
                Text { text: I18n.tr("Delete"); color: white; font-size: 11px * root.s; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { if !root.saving { root.command("remove", song.id); root.pending-remove = ""; root.selected-row = max(0, min(root.selected-row, root.draft.length - 1)); } } }
            }
        }
    }
    if root.review: Rectangle {
        x: 0px; y: root.height - (root.editing ? 60px : 105px) * root.s; width: root.width; height: 36px * root.s;
        NanoActionButton { x: (root.editing ? 6px : 10px) * root.s; width: (root.editing ? 108px : 64px) * root.s; s: root.s; text-size: 10px * root.s; label: "Move Up"; enabled: root.selected-row > 0 && !root.persisted && !root.saving; clicked => { root.command("up", root.draft[root.selected-row].id); root.selected-row -= 1; } }
        NanoActionButton { x: (root.editing ? 126px : 82px) * root.s; width: (root.editing ? 108px : 64px) * root.s; s: root.s; text-size: 10px * root.s; label: "Move Down"; enabled: root.selected-row + 1 < root.draft.length && !root.persisted && !root.saving; clicked => { root.command("down", root.draft[root.selected-row].id); root.selected-row += 1; } }
        if !root.editing: NanoActionButton { x: 154px * root.s; width: 76px * root.s; s: root.s; label: "Remove"; enabled: root.selected-row < root.draft.length && !root.persisted && !root.saving; clicked => { root.command("remove", root.draft[root.selected-row].id); root.selected-row = max(0, min(root.selected-row, root.draft.length - 1)); } }
    }
    Text { x: 10px * root.s; y: root.height - (root.editing && root.review ? 24px : 64px) * root.s; width: parent.width - 20px * root.s; height: 20px * root.s; text: I18n.tr(root.instruction); color: #49637c; font-size: 10px * root.s; overflow: elide; vertical-alignment: center; }
    if !root.editing || !root.review: NanoActionButton { x: 10px * root.s; y: root.height - 39px * root.s; width: (parent.width - 28px * root.s) / 2; s: root.s; label: root.review ? "Back" : "Cancel"; enabled: !root.saving; clicked => { if root.review { root.back-to-selection(); } else { root.command("cancel", ""); } } }
    if !root.editing || !root.review: NanoActionButton { x: (parent.width + 8px * root.s) / 2; y: root.height - 39px * root.s; width: (parent.width - 28px * root.s) / 2; s: root.s; primary: true; label: root.saving ? "Saving…" : (root.review ? (root.editing ? "Done" : "Create") : "Review"); enabled: (!root.review || root.name != "") && (root.editing || root.draft.length > 0) && !root.persisted && !root.saving; clicked => { if root.review { root.command("create", ""); } else { root.review-draft(); } } }
}
