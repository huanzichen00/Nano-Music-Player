import { DesktopStyle, DesktopSurface, DesktopCard, SurfaceText } from "desktop-surfaces.slint";
import { ElasticFlickable } from "overscroll.slint";
import { NanoActionButton } from "components.slint";
import { I18n } from "i18n.slint";

export struct PlaylistCandidate { id: string, title: string, artist: string, selected: bool }

export component PlaylistEditor inherits Rectangle {
    in property <float> s: 1;
    in property <bool> open;
    in property <bool> editing;
    in property <bool> touch-mode: false;
    private property <length> title-height: root.touch-mode ? max(32px * root.s, 44px) : 32px * root.s;
    private property <length> edit-actions-height: root.touch-mode ? max(32px * root.s, 44px) : 32px * root.s;
    private property <string> pending-remove;
    private property <string> drag-id;
    private property <int> drag-source;
    private property <int> drag-target;
    private property <length> drag-pointer-y;
    public function cancel-drag() { root.drag-id = ""; }
    function update-drop() {
        root.drag-target = clamp(floor((root.drag-pointer-y - draft-scroll.y - draft-scroll.content-y) / (48px * root.s)), 0, max(0, root.draft.length - 1));
    }
    changed open => { if !root.open { root.cancel-drag(); } }
    changed saving => { if root.saving { root.cancel-drag(); } }
    changed review => { root.cancel-drag(); if root.touch-mode { root.dismiss-editor(); } }
    drag-scroll-timer := Timer {
        interval: 50ms; running: root.drag-id != "" && root.open && root.review && !root.saving;
        triggered => {
            if root.drag-pointer-y < draft-scroll.y + 24px * root.s { draft-scroll.content-y = min(0px, draft-scroll.content-y + 8px * root.s); }
            else if root.drag-pointer-y > draft-scroll.y + draft-scroll.height - 24px * root.s { draft-scroll.content-y = max(draft-scroll.height - draft-scroll.content-height, draft-scroll.content-y - 8px * root.s); }
            root.update-drop();
        }
    }
    in property <[PlaylistCandidate]> candidates;
    in property <[PlaylistCandidate]> draft;
    in property <string> message;
    in property <bool> persisted;
    in property <bool> library-loading;
    in property <bool> saving;
    in-out property <string> name;
    out property <bool> name-focused: name-input.has-focus;
    out property <bool> reviewing: review;
    private property <bool> review;
    private property <int> selected-row;
    private property <string> instruction: root.message != "Draft only · not saved" && root.message != "Changes not saved" ? root.message
        : root.editing ? "Done saves changes; Cancel discards"
        : root.review ? "Create saves this playlist"
        : root.draft.length == 0 ? "Select songs, then Review" : "Review, then Create to save";
    callback command(string, string);
    public function focus-name() { name-input.focus(); }
    public function dismiss-editor() { focus-sink.focus(); }
    public function reset-view() { root.review = false; root.pending-remove = ""; root.selected-row = 0; candidate-scroll.content-y = 0px; draft-scroll.content-y = 0px; }
    public function show-review() { root.review = true; root.pending-remove = ""; root.selected-row = 0; }
    public function review-draft() {
        if (root.editing || root.draft.length > 0) && !root.saving {
            root.command("review", "");
            if root.name != "" { root.show-review(); }
        }
    }
    public function back-to-selection() { root.review = false; root.pending-remove = ""; root.selected-row = 0; }
    public function move-selection(delta: int) {
        root.selected-row = clamp(root.selected-row + delta, 0, max(0, (root.review ? root.draft.length : root.candidates.length) - 1));
    }
    public function toggle-selection() {
        if !root.review && root.selected-row < root.candidates.length { root.command("toggle", root.candidates[root.selected-row].id); }
    }
    changed selected-row => {
        if root.review {
            draft-scroll.content-y = min(0px, clamp(draft-scroll.content-y, -root.selected-row * 48px * root.s, draft-scroll.height - (root.selected-row + 1) * 48px * root.s));
        } else {
            candidate-scroll.content-y = min(0px, clamp(candidate-scroll.content-y, -root.selected-row * 48px * root.s, candidate-scroll.height - (root.selected-row + 1) * 48px * root.s));
        }
    }
    visible: root.open; background: root.touch-mode ? #f4f5f6 : #20252b;
    if !root.touch-mode: DesktopSurface { x: 4px * root.s; y: 4px * root.s; width: root.width - 8px * root.s; height: root.height - 8px * root.s; s: root.s; background: #edf1f6; }
    focus-sink := FocusScope { x: 0px; y: 0px; width: 0px; height: 0px; }
    TouchArea {}
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.title-height;
        background: root.touch-mode ? @linear-gradient(180deg, #f1f2f3, #aeb3b8) : transparent;
        SurfaceText { modern: !root.touch-mode; x: 68px * root.s; width: parent.width - (root.touch-mode ? 136px : 78px) * root.s; text: root.editing && root.review ? root.name : I18n.tr(root.review ? "Review Playlist" : root.editing ? "Edit Playlist" : "New Playlist"); color: root.touch-mode ? #252a30 : DesktopStyle.text; font-size: 14px * root.s; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        SurfaceText { modern: !root.touch-mode; x: (root.touch-mode ? 6px : 14px) * root.s; width: 56px * root.s; text: I18n.tr("Cancel"); color: root.touch-mode ? #286dac : DesktopStyle.accent; font-size: 11px * root.s; vertical-alignment: center; overflow: elide; TouchArea { clicked => { root.command("cancel", ""); } } }
        if root.touch-mode: NanoActionButton { modern: !root.touch-mode; x: parent.width - 62px * root.s; y: 0px; width: 56px * root.s; height: parent.height; s: root.s; label: "Done"; clicked => { root.dismiss-editor(); } }
    }
    Rectangle {
        visible: !root.review;
        x: 0px; y: root.title-height; width: root.width; height: 101px * root.s;
        SurfaceText { modern: !root.touch-mode; x: 10px * root.s; y: 9px * root.s; width: parent.width - 20px * root.s; height: 18px * root.s; text: I18n.tr("Playlist Name"); color: #647181; font-size: 11px * root.s; }
        Rectangle {
            x: 10px * root.s; y: 33px * root.s; width: parent.width - 20px * root.s; height: root.touch-mode ? max(32px * root.s, 44px) : 32px * root.s;
            background: white; border-color: name-input.has-focus ? #4b96da : #b6bbc0; border-width: 1px * root.s; border-radius: (root.touch-mode ? 4px : 10px) * root.s;
            if root.name == "": SurfaceText { modern: !root.touch-mode; x: 8px * root.s; width: parent.width - 16px * root.s; text: I18n.tr("Name (optional)"); font-size: 12px * root.s; color: #8793a0; vertical-alignment: center; }
            // Keep padding clickable without covering TextInput's selection.
            TouchArea { enabled: root.open && !root.review && !root.saving; clicked => { name-input.focus(); } }
            name-input := TextInput { enabled: root.open && !root.review && !root.saving; x: 8px * root.s; width: parent.width - 16px * root.s; height: parent.height; text <=> root.name; font-size: 12px * root.s; color: root.touch-mode ? #263441 : DesktopStyle.text; single-line: true; vertical-alignment: center; accepted => { if root.touch-mode { root.dismiss-editor(); } } }
        }
        SurfaceText { modern: !root.touch-mode; x: 10px * root.s; y: 75px * root.s; width: parent.width - 20px * root.s; height: 20px * root.s; text: I18n.tr("Choose Songs") + " · " + root.draft.length; font-size: 11px * root.s; color: root.touch-mode ? #49637c : DesktopStyle.secondary; vertical-alignment: center; }
    }
    if root.editing && root.review: Rectangle {
        x: 0px; y: root.title-height; width: root.width; height: root.edit-actions-height;
        background: root.touch-mode ? @linear-gradient(180deg, #8badcf, #446b93) : transparent;
        NanoActionButton { modern: !root.touch-mode; x: 6px * root.s; y: root.touch-mode ? 0px : 4px * root.s; width: 108px * root.s; height: root.touch-mode ? parent.height : 24px * root.s; s: root.s; primary: true; label: root.saving ? "Saving…" : "Done"; enabled: !root.saving && root.name != ""; clicked => { root.command("create", ""); } }
        NanoActionButton { modern: !root.touch-mode; x: 126px * root.s; y: root.touch-mode ? 0px : 4px * root.s; width: 108px * root.s; height: root.touch-mode ? parent.height : 24px * root.s; s: root.s; primary: true; label: "Add"; enabled: !root.saving; clicked => { root.back-to-selection(); root.focus-name(); } }
    }
    if root.review && !root.editing: Rectangle {
        x: 0px; y: root.title-height; width: root.width; height: 65px * root.s;
        SurfaceText { modern: !root.touch-mode; x: 10px * root.s; y: 8px * root.s; width: parent.width - 20px * root.s; height: 22px * root.s; text: root.name; color: root.touch-mode ? #263441 : DesktopStyle.text; font-size: 14px * root.s; font-weight: 700; overflow: elide; }
        SurfaceText { modern: !root.touch-mode; x: 10px * root.s; y: 35px * root.s; width: parent.width - 20px * root.s; height: 20px * root.s; text: root.draft.length + I18n.tr(" songs"); color: root.touch-mode ? #49637c : DesktopStyle.secondary; font-size: 10px * root.s; vertical-alignment: center; }
    }
    candidate-scroll := ElasticFlickable {
        s: root.s; enabled: root.open && !root.review && !root.saving;
        visible: !root.review; x: 0px; y: root.title-height + 101px * root.s; width: root.width; height: max(0px, root.height - self.y - 70px * root.s);
        content-height: max(self.height, root.candidates.length * 48px * root.s);
        for song[index] in root.candidates: Rectangle {
            x: 0px; y: index * 48px * root.s; width: root.width; height: 48px * root.s;
            background: root.touch-mode ? (root.selected-row == index && !root.name-focused ? @linear-gradient(180deg, #4794e4, #1666bb) : white) : transparent;
            if !root.touch-mode: DesktopCard { x: 6px * root.s; y: 1px * root.s; width: parent.width - 12px * root.s; height: 46px * root.s; s: root.s; border-radius: 10px * root.s; background: root.selected-row == index && !root.name-focused ? DesktopStyle.selection : DesktopStyle.card; }
            Rectangle { visible: root.touch-mode; x: 0px; y: parent.height - 1px * root.s; width: root.width; height: 1px * root.s; background: #d5d5d5; }
            Rectangle { x: 10px * root.s; y: 15px * root.s; width: 18px * root.s; height: self.width; border-radius: 3px * root.s; border-width: 1px * root.s; border-color: #93a4b5; background: song.selected ? #3183cc : #f5f8fb; SurfaceText { modern: !root.touch-mode; text: song.selected ? "✓" : ""; color: white; font-size: 13px * root.s; horizontal-alignment: center; vertical-alignment: center; } }
            SurfaceText { modern: !root.touch-mode; x: 38px * root.s; y: 5px * root.s; width: parent.width - 48px * root.s; height: 22px * root.s; text: song.title; font-size: 13px * root.s; font-weight: 600; color: root.touch-mode ? (root.selected-row == index && !root.name-focused ? white : #263441) : DesktopStyle.text; overflow: elide; }
            SurfaceText { modern: !root.touch-mode; x: 38px * root.s; y: 28px * root.s; width: parent.width - 48px * root.s; height: 16px * root.s; text: song.artist; font-size: 11px * root.s; color: root.touch-mode ? (root.selected-row == index && !root.name-focused ? #e1efff : #929292) : DesktopStyle.secondary; overflow: elide; }
            TouchArea { clicked => { if !root.saving && !root.library-loading { root.selected-row = index; root.command("toggle", song.id); } } }
        }
        if root.candidates.length == 0: SurfaceText { modern: !root.touch-mode; x: 16px * root.s; width: root.width - 32px * root.s; height: 170px * root.s; text: I18n.tr(root.library-loading ? "Loading music library…" : "Import music to choose songs."); color: root.touch-mode ? #788390 : DesktopStyle.secondary; font-size: 12px * root.s; wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
    }
    draft-scroll := ElasticFlickable {
        s: root.s; enabled: root.open && root.review && root.drag-id == "" && !root.saving;
        visible: root.review; x: 0px; y: root.title-height + (root.editing ? root.edit-actions-height : 65px * root.s); width: root.width; height: max(0px, root.height - self.y - (root.editing ? 64px : 112px) * root.s);
        content-height: max(self.height, root.draft.length * 48px * root.s);
        for song[index] in root.draft: Rectangle {
            opacity: root.drag-id == song.id ? 0.45 : 1;
            x: 0px; y: index * 48px * root.s; width: root.width; height: 48px * root.s;
            background: root.touch-mode ? (root.selected-row == index ? @linear-gradient(180deg, #4794e4, #1666bb) : white) : transparent;
            if !root.touch-mode: DesktopCard { x: 6px * root.s; y: 1px * root.s; width: parent.width - 12px * root.s; height: 46px * root.s; s: root.s; border-radius: 10px * root.s; background: root.selected-row == index ? DesktopStyle.selection : DesktopStyle.card; }
            Rectangle { visible: root.touch-mode; x: 0px; y: parent.height - 1px * root.s; width: root.width; height: 1px * root.s; background: #d5d5d5; }
            if !root.editing: SurfaceText { modern: !root.touch-mode; x: 9px * root.s; width: 20px * root.s; text: index + 1; font-size: 11px * root.s; color: root.touch-mode ? (root.selected-row == index ? #e1efff : #93a0ae) : DesktopStyle.secondary; vertical-alignment: center; }
            SurfaceText { modern: !root.touch-mode; x: 34px * root.s; y: 5px * root.s; width: parent.width - (root.editing ? (root.pending-remove == song.id ? 104px : 64px) : 44px) * root.s; height: 22px * root.s; text: song.title; font-size: 13px * root.s; font-weight: 600; color: root.touch-mode ? (root.selected-row == index ? white : #263441) : DesktopStyle.text; overflow: elide; }
            SurfaceText { modern: !root.touch-mode; x: 34px * root.s; y: 28px * root.s; width: parent.width - (root.editing ? (root.pending-remove == song.id ? 104px : 64px) : 44px) * root.s; height: 16px * root.s; text: song.artist; font-size: 11px * root.s; color: root.touch-mode ? (root.selected-row == index ? #e1efff : #929292) : DesktopStyle.secondary; overflow: elide; }
            TouchArea { clicked => { root.selected-row = index; } }
            if root.editing: Rectangle {
                x: 8px * root.s; y: 16px * root.s; width: 17px * root.s; height: self.width;
                Image { source: @image-url("../assets/icons/playlist-remove.svg"); image-fit: contain; width: parent.width; height: parent.height; }
                TouchArea { x: root.touch-mode ? -8px * root.s : 0px; y: root.touch-mode ? -12px * root.s : 0px; width: root.touch-mode ? max(33px * root.s, 44px) : parent.width; height: root.touch-mode ? max(41px * root.s, 44px) : parent.height; clicked => { if !root.saving { root.selected-row = index; root.pending-remove = root.pending-remove == song.id ? "" : song.id; } } }
            }
            if root.editing && root.pending-remove != song.id: Rectangle {
                x: parent.width - 30px * root.s; width: 30px * root.s; height: parent.height;
                SurfaceText { modern: !root.touch-mode; text: "≡"; color: #a5a9ae; font-size: 18px * root.s; horizontal-alignment: center; vertical-alignment: center; }

            }
            if root.editing && root.pending-remove == song.id: Rectangle {
                x: parent.width - 65px * root.s; y: root.touch-mode ? 8px : 10px * root.s; width: 60px * root.s; height: root.touch-mode ? 44px : 28px * root.s;
                border-radius: (root.touch-mode ? 4px : 10px) * root.s; border-width: root.touch-mode ? 1px * root.s : 0px; border-color: #9a2727; background: root.touch-mode ? @linear-gradient(180deg, #e88876, #b72c22) : #ff3b30;
                SurfaceText { modern: !root.touch-mode; text: I18n.tr("Delete"); color: white; font-size: 11px * root.s; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                TouchArea { clicked => { if !root.saving { root.command("remove", song.id); root.pending-remove = ""; root.selected-row = max(0, min(root.selected-row, root.draft.length - 1)); } } }
            }
        }
    }
    // Keep drag capture on the viewport, so the source row can scroll offscreen.
    TouchArea {
        x: root.width - (root.touch-mode ? max(30px * root.s, 44px) : 30px * root.s); y: draft-scroll.y; width: root.touch-mode ? max(30px * root.s, 44px) : 30px * root.s; height: draft-scroll.height;
        enabled: root.open && root.editing && root.review && !root.saving && root.pending-remove == "";
        pointer-event(event) => {
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                let index = floor((self.mouse-y - draft-scroll.content-y) / (48px * root.s));
                if index >= 0 && index < root.draft.length {
                    root.drag-source = index; root.drag-target = index; root.selected-row = index;
                    root.drag-pointer-y = draft-scroll.y + self.mouse-y;
                    root.drag-id = root.draft[index].id;
                }
            }
            if event.button == PointerEventButton.left && event.kind == PointerEventKind.up && root.drag-id != "" {
                let id = root.drag-id; let target = root.drag-target;
                root.cancel-drag(); root.command("move:" + target, id); root.selected-row = target;
            }
            if event.kind == PointerEventKind.cancel { root.cancel-drag(); }
        }
        moved => {
            if self.pressed && root.drag-id != "" {
                root.drag-pointer-y = draft-scroll.y + self.mouse-y; root.update-drop();
            }
        }
    }
    if root.drag-id != "": Rectangle {
        x: 2px * root.s; y: clamp(draft-scroll.y + draft-scroll.content-y + (root.drag-target + (root.drag-target > root.drag-source ? 1 : 0)) * 48px * root.s, draft-scroll.y, draft-scroll.y + draft-scroll.height - 2px * root.s);
        width: root.width - 4px * root.s; height: 2px * root.s; background: #1876ca;
    }
    if root.review: Rectangle {
        x: 0px; y: root.height - (root.editing ? 60px : 105px) * root.s; width: root.width; height: 36px * root.s;
        NanoActionButton { modern: !root.touch-mode; x: (root.editing ? 6px : 10px) * root.s; width: (root.editing ? 108px : 64px) * root.s; s: root.s; height: root.touch-mode ? 44px : 32px * root.s; text-size: 10px * root.s; label: "Move Up"; enabled: root.selected-row > 0 && !root.persisted && !root.saving; clicked => { root.command("up", root.draft[root.selected-row].id); root.selected-row -= 1; } }
        NanoActionButton { modern: !root.touch-mode; x: (root.editing ? 126px : 82px) * root.s; width: (root.editing ? 108px : 64px) * root.s; s: root.s; height: root.touch-mode ? 44px : 32px * root.s; text-size: 10px * root.s; label: "Move Down"; enabled: root.selected-row + 1 < root.draft.length && !root.persisted && !root.saving; clicked => { root.command("down", root.draft[root.selected-row].id); root.selected-row += 1; } }
        if !root.editing: NanoActionButton { modern: !root.touch-mode; x: 154px * root.s; width: 76px * root.s; s: root.s; height: root.touch-mode ? 44px : 32px * root.s; label: "Remove"; enabled: root.selected-row < root.draft.length && !root.persisted && !root.saving; clicked => { root.command("remove", root.draft[root.selected-row].id); root.selected-row = max(0, min(root.selected-row, root.draft.length - 1)); } }
    }
    SurfaceText { modern: !root.touch-mode; x: 10px * root.s; y: root.height - (root.editing && root.review ? 24px : 64px) * root.s; width: parent.width - 20px * root.s; height: 20px * root.s; text: I18n.tr(root.instruction); color: root.touch-mode ? #49637c : DesktopStyle.secondary; font-size: 10px * root.s; overflow: elide; vertical-alignment: center; }
    if !root.editing || !root.review: NanoActionButton { modern: !root.touch-mode; x: 10px * root.s; y: root.height - 39px * root.s; width: (parent.width - 28px * root.s) / 2; s: root.s; height: root.touch-mode ? 44px : 32px * root.s; label: root.review ? "Back" : "Cancel"; enabled: !root.saving; clicked => { if root.review { root.back-to-selection(); } else { root.command("cancel", ""); } } }
    if !root.editing || !root.review: NanoActionButton { modern: !root.touch-mode; x: (parent.width + 8px * root.s) / 2; y: root.height - 39px * root.s; width: (parent.width - 28px * root.s) / 2; s: root.s; height: root.touch-mode ? 44px : 32px * root.s; primary: true; label: root.saving ? "Saving…" : (root.review ? (root.editing ? "Done" : "Create") : "Review"); enabled: (!root.review || root.name != "") && (root.editing || root.draft.length > 0) && !root.persisted && !root.saving; clicked => { if root.review { root.command("create", ""); } else { root.review-draft(); } } }
}
