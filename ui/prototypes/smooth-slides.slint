// Standalone visual prototype; intentionally not imported by the production UI.
// Call navigate(direction) to retarget while the current animation is in flight.
export component SmoothSlidesPrototype inherits Window {
    width: 480px;
    height: 360px;
    title: "Smooth Slides Prototype";
    background: #20232a;

    in-out property <int> page: 0;
    in-out property <int> from-page: 0;
    in-out property <int> direction: 1;
    in-out property <bool> moving: false;
    in-out property <bool> animating: false;
    in-out property <bool> motion-enabled: true;
    in-out property <float> progress: 1.0;
    in-out property <length> travel: 480px;
    out property <length> outgoing-offset: root.moving && root.motion-enabled ? -root.direction * root.progress * root.travel : 0px;
    out property <length> incoming-offset: root.moving && root.motion-enabled ? root.direction * (1.0 - root.progress) * root.travel : 0px;
    public function start-transition(next-direction: int) {
        root.from-page = root.page;
        root.direction = next-direction < 0 ? -1 : 1;
        root.page = root.page + 1;
        if !root.motion-enabled { root.progress = 1.0; root.moving = false; return; }
        root.animating = false;
        root.progress = 0.0;
        root.moving = true;
        root.animating = true;
        root.progress = 1.0;
    }

    public function set-motion-enabled(enabled: bool) {
        root.motion-enabled = enabled;
        if !enabled && root.moving {
            root.animating = false;
            root.progress = 1.0;
            root.moving = false;
        }
    }

    animate progress { duration: root.animating ? 240ms : 0ms; easing: ease-in-out; }
    changed progress => { if root.progress >= 1.0 && root.moving { root.moving = false; root.animating = false; } }

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        clip: true; background: #f3f4f6;

        Rectangle {
            x: root.outgoing-offset;
            y: 0px; width: parent.width; height: parent.height;
            background: #fafafa;
            Text {
                x: 0px; y: 130px; width: parent.width; height: 40px;
                text: root.moving ? "Screen " + root.from-page : "Screen " + root.page; color: #252a31; font-size: 24px;
                horizontal-alignment: center;
            }
        }

        if root.moving: Rectangle {
            x: root.incoming-offset;
            y: 0px; width: parent.width; height: parent.height;
            background: #dceeff;
            Text {
                x: 0px; y: 130px; width: parent.width; height: 40px;
                text: "Destination screen " + root.page; color: #174f84; font-size: 24px;
                horizontal-alignment: center;
            }
        }
    }

    Rectangle {
        x: 115px; y: parent.height - 48px; width: 112px; height: 34px;
        background: #2673b9; border-radius: 5px;
        Text { text: "Back  ←"; color: white; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.start-transition(-1); } }
    }
    Rectangle {
        x: 247px; y: parent.height - 48px; width: 120px; height: 34px;
        background: #2673b9; border-radius: 5px;
        Text { text: "Forward  →"; color: white; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.start-transition(1); } }
    }
}
