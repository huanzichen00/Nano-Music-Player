import { HomeView } from "home.slint";
import "fonts/maple-mono/MapleMono-Regular.ttf";
import "fonts/maple-mono/MapleMono-SemiBold.ttf";
import "fonts/maple-mono/MapleMono-Bold.ttf";
import "fonts/jetbrains-mono/JetBrainsMono-Regular.ttf";
import "fonts/jetbrains-mono/JetBrainsMono-SemiBold.ttf";
import "fonts/jetbrains-mono/JetBrainsMono-Bold.ttf";
import { LibraryView, LibraryRow, GeniusRow, ListMetrics } from "library.slint";
import { VideoView } from "video.slint";
import { VideoDeviceFrame } from "video-device.slint";
import { NowPlayingView } from "now-playing.slint";
import { ShortcutEditor } from "shortcut-editor.slint";
import { DeepSeekSettings } from "deepseek-settings.slint";
import { GeniusPreview } from "genius-preview.slint";
import { PlaylistEditor, PlaylistCandidate } from "playlist-editor.slint";
import { I18n } from "i18n.slint";
export { I18n }
export { LibraryRow }
export { GeniusRow }
export { ListMetrics }
export { PlaylistCandidate }
export struct ShortcutRow { category: string, title: string, keys: string }

export component AppWindow inherits Window {
    title: "iPod nano";
    preferred-width: 370px; preferred-height: 296px * 76.5 / 39.6 * 1.25;
    min-width: root.base-width * 0.75;
    min-height: root.base-height * 0.75;
    max-width: root.base-width * 3;
    max-height: root.base-height * 3;
    no-frame: device-mode;
    resize-border-width: device-mode ? 5px : 0px;
    background: device-mode ? transparent : #fff;
    always-on-top: root.keep-on-top;
    in property <bool> keep-on-top: true;
    default-font-family: root.ui-font-family;
    in property <string> ui-font-family: "Helvetica Neue";
    in property <bool> device-mode: true;
    in property <int> screen;
    in property <bool> smooth-slides: true;
    in property <int> transition-direction: 1;
    in property <int> screen-transition-generation: 0;
    in property <int> previous-screen;
    in property <string> previous-screen-title;
    in property <int> previous-selected;
    in property <int> previous-home-page;
    in property <int> previous-home-transition-direction: 1;
    in-out property <[LibraryRow]> previous-rows;
    in property <bool> previous-playlist-list;
    in property <bool> previous-playlist-content;
    in-out property <length> previous-list-scroll-y;
    in-out property <length> previous-lyric-scroll-y;
    private property <bool> transition-active: false;
    private property <bool> transition-animating: false;
    private property <length> current-screen-x: 0px;
    private property <length> previous-screen-x: 0px;
    transition-completion := Timer {
        interval: 230ms; running: false;
        triggered => {
            root.transition-active = false;
            root.transition-animating = false;
            root.previous-rows = [];
            self.stop();
        }
    }
    private property <bool> previous-artwork-list: root.previous-screen == 1 && root.previous-rows.length > 0 && root.previous-rows[0].show-artwork;
    out property <length> transition-offset: root.transition-active ? root.current-screen-x : 0px;
    out property <length> previous-transition-offset: root.transition-active ? root.previous-screen-x : 0px;
    out property <length> home-transition-offset: home.page-slide-offset;
    out property <length> home-outgoing-transition-offset: home.page-outgoing-offset;
    animate current-screen-x { duration: root.transition-animating ? 220ms : 0ms; easing: ease-in-out; }
    animate previous-screen-x { duration: root.transition-animating ? 220ms : 0ms; easing: ease-in-out; }
    changed screen-transition-generation => {
        transition-completion.stop();
        root.transition-active = false;
        root.transition-animating = false;
        root.current-screen-x = 0px;
        root.previous-screen-x = 0px;
        if !root.smooth-slides || root.screen == 9 || root.previous-screen == 9 {
            root.previous-rows = [];
            return;
        } else {
            root.current-screen-x = root.transition-direction * display.width;
            root.transition-active = true;
            root.transition-animating = true;
            root.current-screen-x = 0px;
            root.previous-screen-x = -root.transition-direction * display.width;
            transition-completion.start();
        }
    }
    changed smooth-slides => {
        if !root.smooth-slides {
            transition-completion.stop();
            root.transition-active = false;
            root.transition-animating = false;
            root.current-screen-x = 0px;
            root.previous-screen-x = 0px;
            root.previous-rows = [];
        }
    }
    in property <bool> video-landscape;
    in property <bool> video-overlay: true;
    in property <image> video-frame;
    in property <string> video-title;
    private property <length> base-width: video-landscape ? (device-mode ? 296px * 76.5 / 39.6 : 432px) : (device-mode ? 296px : 240px);
    private property <length> base-height: video-landscape ? (device-mode ? 296px : 240px) : (device-mode ? 296px * 76.5 / 39.6 : 432px);
    in property <string> screen-title;
    in property <int> selected;
    in property <int> home-page;
    in property <int> home-transition-direction: 1;
    in property <string> clock-text;
    in property <bool> playing;
    in property <bool> has-track;
    in property <string> track-path;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <image> artwork;
    in property <float> volume: 0.5;
    in property <bool> muted;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> remaining;
    in property <string> duration;
    in property <string> track-count;
    in property <bool> shuffle;
    in property <string> repeat-mode;
    in property <string> notice;
    in property <[LibraryRow]> rows;
    in property <[ShortcutRow]> shortcuts;
    in property <bool> reference-open;
    in property <bool> lyrics-visible;
    in property <bool> overlay-visible;
    in property <bool> keyboard-navigation;
    in property <bool> shortcut-editor-open;
    in property <bool> shortcut-recording;
    in property <string> shortcut-title;
    in property <string> shortcut-keys;
    in property <string> shortcut-message;
    in property <[string]> lyric-lines;
    in property <[string]> romaji-lines;
    in property <bool> romaji-visible;
    in property <[string]> translated-lines;
    in property <bool> translation-visible;
    in property <bool> deepseek-settings-open;
    in property <bool> deepseek-key-configured;
    in property <string> deepseek-message;
    in-out property <string> deepseek-api-key;
    in-out property <string> deepseek-model: "deepseek-flash";
    in-out property <bool> genius-preview-open;
    in-out property <string> genius-seed-path;
    in property <[GeniusRow]> genius-songs;
    in property <string> genius-message;
    in property <bool> genius-busy;
    out property <int> genius-preview-stage: genius-preview.stage;
    out property <int> genius-preview-variation: genius-preview.variation;
    private property <string> genius-seed-title;
    private property <string> genius-seed-artist;
    private property <bool> genius-seed-available;
    in-out property <bool> playlist-editor-open;
    in-out property <string> playlist-name;
    in property <[PlaylistCandidate]> playlist-candidates;
    in property <[PlaylistCandidate]> playlist-draft;
    in-out property <string> playlist-message;
    in property <bool> playlist-persisted;
    in property <bool> playlist-library-loading: false;
    in property <bool> playlist-saving: false;
    in property <bool> playlist-list: false;
    in property <bool> playlist-content: false;
    in property <bool> playlist-editing: false;
    out property <bool> playlist-reviewing: playlist-editor.reviewing;
    in property <int> active-lyric: -1;
    in property <bool> timed-lyrics;
    in-out property <string> search-text;
    in-out property <length> list-scroll-y;
    out property <float> list-row-height: library.row-height / 1px;
    out property <float> list-viewport-height: library.height / 1px;
    private property <bool> artwork-list: root.screen == 1 && root.rows.length > 0 && root.rows[0].show-artwork;
    in-out property <length> lyric-scroll-y;
    out property <bool> search-focused: library.search-focused;
    out property <float> display-scale: s;
    out property <length> content-height: keyboard.height;
    out property <float> lyric-content-height: now-playing.lyric-content-height / 1px;
    private property <float> s: min(keyboard.width / root.base-width, keyboard.height / root.base-height);
    callback key-event(KeyEvent, bool) -> bool;
    callback modal-key-event(KeyEvent, bool) -> bool;
    callback command(string);
    callback shortcut-command(string);
    callback deepseek-command(string);
    callback genius-command(string);
    callback open-genius-requested;
    callback playlist-command(string, string);
    callback item-clicked(int);
    callback query-changed(string);
    callback volume-changed(float);
    callback seek-changed(float);
    callback home-swipe(bool);
    public function focus-screen() {
        if root.deepseek-settings-open { deepseek-dialog.focus-editor(); }
        else if root.playlist-editor-open && !playlist-editor.reviewing { playlist-editor.focus-name(); }
        else { keyboard.focus(); }
    }
    public function focus-search() { library.focus-search(); }
    public function cancel-screen-transition() {
        transition-completion.stop();
        root.transition-active = false;
        root.transition-animating = false;
        root.current-screen-x = 0px;
        root.previous-screen-x = 0px;
        root.previous-rows = [];
        home.cancel-page-transition();
    }
    changed deepseek-settings-open => { root.focus-screen(); }
    public function open-genius-preview() {
        if root.genius-preview-open { return; }
        root.genius-seed-available = root.has-track;
        root.genius-seed-title = root.has-track ? root.track-title : I18n.tr("No song selected");
        root.genius-seed-artist = root.has-track ? root.track-artist : "";
        root.genius-seed-path = root.track-path;
        genius-preview.stage = 0;
        genius-preview.variation = 0;
        root.genius-preview-open = true;
        keyboard.focus();
    }
    public function prepare-genius-action(name: string) -> bool {
        if name != "close" && !root.genius-seed-available { return false; }
        if name != "close" && root.genius-busy { return false; }
        if (name == "play" || name == "save") && root.genius-songs.length == 0 { return false; }
        if name == "close" { root.genius-preview-open = false; root.focus-screen(); }
        else if name == "create" { genius-preview.stage = 1; }
        else if name == "refresh" { genius-preview.variation += 1; genius-preview.stage = 1; }
        else if name == "play" && genius-preview.stage > 0 { genius-preview.stage = 2; }
        else if name == "save" && genius-preview.stage > 0 { genius-preview.stage = 3; }
        return true;
    }
    public function genius-action(name: string) {
        if root.prepare-genius-action(name) { root.genius-command(name); }
    }
    public function open-playlist-editor() {
        root.playlist-name = "";
        root.playlist-message = "Draft only · not saved";
        playlist-editor.reset-view();
        root.playlist-editor-open = true;
        playlist-editor.focus-name();
    }
    public function open-saved-playlist-editor() {
        playlist-editor.reset-view();
        root.playlist-editor-open = true;
        playlist-editor.show-review();
        keyboard.focus();
    }
    public function playlist-action(name: string, id: string) {
        if root.playlist-saving { return; }
        if name == "cancel" { root.playlist-editor-open = false; root.focus-screen(); }
        root.playlist-command(name, id);
        if name == "toggle" || name == "review" { keyboard.focus(); }
    }

    // Menu commands share the Rust reducer; no menu accelerators bypass keyboard context guards.
    MenuBar {
        Menu {
            title: I18n.tr("File");
            MenuItem { title: I18n.tr("New Playlist…"); enabled: !root.playlist-editor-open && !root.deepseek-settings-open && !root.genius-preview-open && !root.shortcut-editor-open && !root.reference-open; activated => { root.command("new_playlist"); } }
            MenuItem { title: I18n.tr("Edit Playlist…"); enabled: root.playlist-content && !root.playlist-editor-open && !root.deepseek-settings-open && !root.genius-preview-open && !root.shortcut-editor-open && !root.reference-open; activated => { root.command("edit_playlist"); } }
            MenuItem { title: I18n.tr("Import Videos…"); activated => { root.command("import_videos"); } }
            MenuItem { title: I18n.tr("Import Music Folder…"); activated => { root.command("import_folder"); } }
            MenuItem { title: I18n.tr("Import / Replace Lyrics…"); activated => { root.command("import_lyrics"); } }
            MenuItem { title: I18n.tr("Search Library…"); activated => { root.command("search"); } }
            MenuItem { title: I18n.tr("Quit"); activated => { root.close(); } }
        }
        Menu {
            title: I18n.tr("Playback");
            MenuItem { title: I18n.tr("Play / Pause"); activated => { root.command("toggle_play"); } }
            MenuItem { title: I18n.tr("Next Track"); activated => { root.command("next_track"); } }
            MenuItem { title: I18n.tr("Previous Track"); activated => { root.command("previous_track"); } }
            MenuItem { title: I18n.tr("Now Playing"); activated => { root.command("now_playing"); } }
            MenuItem { title: I18n.tr("Lyrics for Track…"); activated => { root.command("manage_lyrics"); } }
            MenuItem { title: I18n.tr("Translate Lyrics"); enabled: root.has-track; activated => { root.command("translate_lyrics"); } }
            MenuItem { title: I18n.tr("Regenerate Translation"); enabled: root.has-track; activated => { root.command("regenerate_translation"); } }
            MenuItem { title: I18n.tr("Cancel Translation"); activated => { root.command("cancel_translation"); } }
            MenuItem { title: I18n.tr("Show / Hide Translation"); activated => { root.command("toggle_translation"); } }
            MenuItem { title: I18n.tr("Remove Translation"); enabled: root.has-track; activated => { root.command("remove_translation"); } }
            MenuItem { title: I18n.tr("Translation: English"); activated => { root.command("translation_target_en"); } }
            MenuItem { title: I18n.tr("Translation: 简体中文"); activated => { root.command("translation_target_zh"); } }
            MenuItem { title: I18n.tr("Translation: 日本語"); activated => { root.command("translation_target_ja"); } }
            MenuItem { title: I18n.tr("Genius Preview…"); enabled: root.has-track && !root.playlist-editor-open && !root.deepseek-settings-open && !root.shortcut-editor-open && !root.reference-open; activated => { root.open-genius-preview(); } }
        }
        Menu {
            title: I18n.tr("View");
            MenuItem { title: I18n.tr("Settings…"); activated => { root.command("settings"); } }
            MenuItem { title: I18n.tr("Device Mode"); activated => { root.command("device_mode"); } }
            MenuItem { title: I18n.tr("Screen Mode"); activated => { root.command("screen_mode"); } }
            MenuItem { title: I18n.tr("Always on Top"); checked: root.keep-on-top; activated => { root.command("toggle_always_on_top"); } }
            MenuItem { title: I18n.tr("Zoom In"); activated => { root.command("zoom_in"); } }
            MenuItem { title: I18n.tr("Zoom Out"); activated => { root.command("zoom_out"); } }
            MenuItem { title: I18n.tr("Home"); activated => { root.command("home"); } }
        }
        Menu { title: I18n.tr("Help"); MenuItem { title: I18n.tr("Keyboard Shortcuts…"); activated => { root.command("show_shortcuts"); } } }
    }
    forward-focus: keyboard;
    keyboard := FocusScope {
        // The sole keyboard entry point for the entire application.
        capture-key-pressed(event) => {
            if root.modal-key-event(event, root.reference-open ? false
                : root.deepseek-settings-open ? deepseek-dialog.editor-focused
                : root.playlist-editor-open ? (!root.playlist-saving && playlist-editor.name-focused)
                : root.genius-preview-open || root.shortcut-editor-open ? false : library.search-focused) { return accept; }
            if root.reference-open { return root.key-event(event, false) ? accept : reject; }
            if root.deepseek-settings-open {
                if event.text == Key.Escape { root.deepseek-command("cancel"); return accept; }
                if event.text == Key.Return { root.deepseek-command("save"); return accept; }
                return reject;
            }
            if root.playlist-editor-open {
                if root.playlist-saving { return accept; }
                if event.text == Key.Escape {
                    if playlist-editor.reviewing { playlist-editor.back-to-selection(); keyboard.focus(); }
                    else { root.playlist-action("cancel", ""); }
                    return accept;
                }
                if event.text == Key.Return && playlist-editor.name-focused { keyboard.focus(); return accept; }
                if playlist-editor.name-focused { return reject; }
                if !event.repeat && (event.text.to-lowercase() == "h" || event.text == Key.LeftArrow) {
                    if playlist-editor.reviewing { playlist-editor.back-to-selection(); keyboard.focus(); }
                    else { root.playlist-action("cancel", ""); }
                    return accept;
                }
                if !event.repeat && (event.text.to-lowercase() == "l" || event.text == Key.RightArrow) {
                    if playlist-editor.reviewing { if root.playlist-name != "" && (root.playlist-editing || root.playlist-draft.length > 0) && !root.playlist-persisted { root.playlist-action("create", ""); } }
                    else { playlist-editor.review-draft(); }
                    return accept;
                }
                if event.text.to-lowercase() == "j" { playlist-editor.move-selection(1); return accept; }
                if event.text.to-lowercase() == "k" { playlist-editor.move-selection(-1); return accept; }
                if event.text == Key.UpArrow { playlist-editor.move-selection(-1); }
                else if event.text == Key.DownArrow { playlist-editor.move-selection(1); }
                else if event.text == Key.Space && !event.repeat { playlist-editor.toggle-selection(); }
                else if event.text == Key.Return && !event.repeat { if !playlist-editor.reviewing { playlist-editor.review-draft(); } else if root.playlist-name != "" && (root.playlist-editing || root.playlist-draft.length > 0) && !root.playlist-persisted { root.playlist-action("create", ""); } }
                return accept;
            }
            if root.genius-preview-open {
                return accept;
            }
            return root.key-event(event, library.search-focused) ? accept : reject;
        }
        if root.device-mode && root.screen != 9: Rectangle {
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            width: 296px * root.s; height: (296px * 76.5 / 39.6) * root.s;
            // SVG keeps gradient curves consistent in native and software renderers.
            Image { source: @image-url("icons/device-shell.svg"); width: parent.width; height: parent.height; image-fit: contain; }
            // Native dragging from the narrow bezel, without touching display gestures.
            WindowMoveArea {}
            Rectangle {
                x: (parent.width - self.width) / 2; y: parent.height - 92px * root.s;
                width: 68px * root.s; height: self.width; border-radius: self.width / 2;
                background: home-touch.pressed ? #deddd5 : #eeede5;
                border-width: 1px * root.s; border-color: #b9bdc2;
                Rectangle { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; width: 30px * root.s; height: self.width; border-radius: self.width / 2; border-width: 1.5px * root.s; border-color: #a7adb5; background: transparent; }
                home-touch := TouchArea { clicked => { root.command("home"); keyboard.focus(); } }
            }
        }
        display := Rectangle {
            visible: root.screen != 9;
            x: (parent.width - self.width) / 2;
            y: root.device-mode ? (parent.height - (296px * 76.5 / 39.6) * root.s) / 2 + 36px * root.s : (parent.height - self.height) / 2;
            width: 240px * root.s; height: 432px * root.s; clip: true; background: #fff;
            border-width: 1px * root.s; border-color: #101010;
            Rectangle {
                visible: root.transition-active;
                x: root.transition-active ? root.previous-screen-x : 0px; y: 0px; width: parent.width; height: parent.height;
            previous-home := HomeView {
                visible: root.previous-screen == 0; y: 26px * root.s; height: 406px * root.s; s: root.s;
                page: root.previous-home-page; selected: root.previous-selected; page-direction: root.previous-home-transition-direction; smooth-slides: root.smooth-slides;
                activated(index) => { root.item-clicked(index); keyboard.focus(); }
                swipe(next) => { root.home-swipe(next); }
            }
            Rectangle {
                x: 0px; y: 0px; height: 26px * root.s;
                background: root.previous-screen == 0 || root.previous-screen == 2 ? @linear-gradient(180deg, #50515d, #32343e) : @linear-gradient(180deg, #f8f8f8, #b4b7bb);
                if !root.previous-artwork-list && !root.previous-playlist-list && !root.previous-playlist-content: Text { x: 5px * root.s; width: parent.width - 10px * root.s; text: root.clock-text; font-size: 13px * root.s; font-weight: 700; color: root.previous-screen == 0 || root.previous-screen == 2 ? white : #333; horizontal-alignment: center; }
                if root.previous-screen == 2: Rectangle {
                    x: 0px; y: 0px; width: 65px * root.s; height: parent.height;
                    Image { x: 6px * root.s; y: 7px * root.s; width: 7px * root.s; height: 12px * root.s; source: @image-url("../assets/icons/chevron-left.svg"); colorize: white; }
                    Text { x: 17px * root.s; width: parent.width - self.x; text: I18n.tr("Back"); font-size: 11px * root.s; color: white; vertical-alignment: center; overflow: elide; }
                    TouchArea { enabled: false; clicked => { root.command("back"); keyboard.focus(); } }
                }
                if root.previous-artwork-list || root.previous-playlist-list || root.previous-playlist-content: Text { x: 20px * root.s; width: 164px * root.s; text: root.previous-screen-title; font-size: 16px * root.s; font-weight: 700; color: #222; overflow: elide; }
                if root.previous-artwork-list || root.previous-playlist-list || root.previous-playlist-content: Image { x: 5px * root.s; y: 7px * root.s; width: 7px * root.s; height: 12px * root.s; source: @image-url("../assets/icons/chevron-left.svg"); colorize: #555; }
                if root.previous-artwork-list || root.previous-playlist-list || root.previous-playlist-content: TouchArea { x: 0px; y: 0px; width: 184px * root.s; clicked => { root.command("back"); keyboard.focus(); } }
                if root.playing: Image { x: 191px * root.s; y: 8px * root.s; width: 8px * root.s; height: 8px * root.s; source: @image-url("../assets/icons/play.svg"); colorize: root.previous-screen == 0 || root.previous-screen == 2 ? #eee : #2a73be; }
                Rectangle {
                    x: 212px * root.s; y: 8px * root.s; width: 20px * root.s; height: 9px * root.s;
                    border-color: #888; border-width: 1px * root.s; background: transparent;
                    Rectangle { x: 2px * root.s; y: 2px * root.s; width: 15px * root.s; height: 5px * root.s; background: root.previous-screen == 0 || root.previous-screen == 2 ? #e1e9f4 : #7a994c; }
                }
            }
            Rectangle {
                visible: root.previous-screen != 0 && root.previous-screen != 2 && !root.previous-artwork-list && !root.previous-playlist-list && !root.previous-playlist-content;
                y: 26px * root.s; height: 38px * root.s;
                background: @linear-gradient(180deg, #f1f2f3, #aeb3b8); border-width: 1px * root.s; border-color: #969ca1;
                Text { x: 51px * root.s; width: parent.width - 102px * root.s; text: root.previous-screen-title; font-size: 16px * root.s; font-weight: 700; color: #252a30; horizontal-alignment: center; overflow: elide; }
                Rectangle {
                    x: 5px * root.s; y: 6px * root.s; width: 39px * root.s; height: 26px * root.s;
                    border-radius: 5px * root.s; border-width: 1px * root.s; border-color: #808891; background: @linear-gradient(180deg, #d9e0e5, #99a3af);
                    Image { source: @image-url("../assets/icons/chevron-left.svg"); colorize: #fff; x: 14px * root.s; y: 6px * root.s; width: 10px * root.s; height: 14px * root.s; }
                    TouchArea { clicked => { root.command("back"); keyboard.focus(); } }
                }
            }
            previous-library := LibraryView {
                visible: root.previous-screen == 1 || root.previous-screen == 3 || root.previous-screen == 5 || root.previous-screen == 6 || root.previous-screen == 7 || root.previous-screen == 8;
                enabled: false;
                y: (root.previous-artwork-list || root.previous-playlist-list || root.previous-playlist-content ? 26px : 64px) * root.s; height: 432px * root.s - self.y; s: root.s;
                playlist-list: root.previous-playlist-list; playlist-content: root.previous-playlist-content;
                compact-title: root.previous-screen == 5 || root.previous-screen == 6 || root.previous-screen == 7 || root.previous-screen == 8; rows: root.previous-rows; selected: root.previous-selected; search: root.previous-screen == 3;
                text-font-family: root.ui-font-family;
                search-text <=> root.search-text; scroll-y <=> root.previous-list-scroll-y;
                activated(index) => { root.item-clicked(index); if !root.playlist-editor-open { keyboard.focus(); } }
                edited(text) => { root.query-changed(text); }
            }
            if root.previous-screen == 4: Text { y: 100px * root.s; height: 250px * root.s; text: root.previous-screen-title + "\n\n" + I18n.tr("This app is not available yet.") + "\n" + I18n.tr("Press Shift + H to return Home."); font-size: 14px * root.s; color: #666; horizontal-alignment: center; vertical-alignment: center; }
            previous-now-playing := NowPlayingView {
                visible: root.previous-screen == 2; y: 26px * root.s; height: 406px * root.s; s: root.s;
                navigation-enabled: false;
                selected: root.previous-selected; selection-visible: root.keyboard-navigation; playing: root.playing; has-track: root.has-track;
                title: root.track-title; artist: root.track-artist; album: root.track-album; artwork: root.artwork;
                volume: root.volume; muted: root.muted; progress: root.progress; elapsed: root.elapsed; duration: root.duration; track-count: root.track-count;
                shuffle: root.shuffle; repeat-mode: root.repeat-mode;
                overlay-visible: root.overlay-visible; lyrics-visible: root.lyrics-visible; lyric-lines: root.lyric-lines; active-lyric: root.active-lyric;
                romaji-lines: root.romaji-lines; romaji-visible: root.romaji-visible;
                translated-lines: root.translated-lines; translation-visible: root.translation-visible;
                lyric-scroll-y <=> root.previous-lyric-scroll-y;
                activated(index) => { root.item-clicked(index); keyboard.focus(); }
                toggle-overlay => { root.command("toggle_overlay"); keyboard.focus(); }
                genius-requested => { root.open-genius-preview(); }
                seek-changed(value) => { root.seek-changed(value); }
                volume-changed(value) => { root.volume-changed(value); }
                back => { root.command("back"); keyboard.focus(); }
            }
                // Keep the outgoing view live but shield its controls while it slides away.
                TouchArea {}
            }
            Rectangle {
                x: root.transition-active ? root.current-screen-x : 0px; y: 0px; width: parent.width; height: parent.height;
            home := HomeView {
                visible: root.screen == 0; y: 26px * root.s; height: 406px * root.s; s: root.s;
                page: root.home-page; selected: root.selected; page-direction: root.home-transition-direction; smooth-slides: root.smooth-slides;
                activated(index) => { root.item-clicked(index); keyboard.focus(); }
                swipe(next) => { root.home-swipe(next); }
            }
            Rectangle {
                x: 0px; y: 0px; height: 26px * root.s;
                background: root.screen == 0 || root.screen == 2 ? @linear-gradient(180deg, #50515d, #32343e) : @linear-gradient(180deg, #f8f8f8, #b4b7bb);
                if !root.artwork-list && !root.playlist-list && !root.playlist-content: Text { x: 5px * root.s; width: parent.width - 10px * root.s; text: root.clock-text; font-size: 13px * root.s; font-weight: 700; color: root.screen == 0 || root.screen == 2 ? white : #333; horizontal-alignment: center; }
                if root.screen == 2: Rectangle {
                    x: 0px; y: 0px; width: 65px * root.s; height: parent.height;
                    Image { x: 6px * root.s; y: 7px * root.s; width: 7px * root.s; height: 12px * root.s; source: @image-url("../assets/icons/chevron-left.svg"); colorize: white; }
                    Text { x: 17px * root.s; width: parent.width - self.x; text: I18n.tr("Back"); font-size: 11px * root.s; color: white; vertical-alignment: center; overflow: elide; }
                    TouchArea { enabled: now-playing.navigation-enabled; clicked => { root.command("back"); keyboard.focus(); } }
                }
                if root.artwork-list || root.playlist-list || root.playlist-content: Text { x: 20px * root.s; width: 164px * root.s; text: root.screen-title; font-size: 16px * root.s; font-weight: 700; color: #222; overflow: elide; }
                if root.artwork-list || root.playlist-list || root.playlist-content: Image { x: 5px * root.s; y: 7px * root.s; width: 7px * root.s; height: 12px * root.s; source: @image-url("../assets/icons/chevron-left.svg"); colorize: #555; }
                if root.artwork-list || root.playlist-list || root.playlist-content: TouchArea { x: 0px; y: 0px; width: 184px * root.s; clicked => { root.command("back"); keyboard.focus(); } }
                if root.playing: Image { x: 191px * root.s; y: 8px * root.s; width: 8px * root.s; height: 8px * root.s; source: @image-url("../assets/icons/play.svg"); colorize: root.screen == 0 || root.screen == 2 ? #eee : #2a73be; }
                Rectangle {
                    x: 212px * root.s; y: 8px * root.s; width: 20px * root.s; height: 9px * root.s;
                    border-color: #888; border-width: 1px * root.s; background: transparent;
                    Rectangle { x: 2px * root.s; y: 2px * root.s; width: 15px * root.s; height: 5px * root.s; background: root.screen == 0 || root.screen == 2 ? #e1e9f4 : #7a994c; }
                }
            }
            Rectangle {
                visible: root.screen != 0 && root.screen != 2 && !root.artwork-list && !root.playlist-list && !root.playlist-content;
                y: 26px * root.s; height: 38px * root.s;
                background: @linear-gradient(180deg, #f1f2f3, #aeb3b8); border-width: 1px * root.s; border-color: #969ca1;
                Text { x: 51px * root.s; width: parent.width - 102px * root.s; text: root.screen-title; font-size: 16px * root.s; font-weight: 700; color: #252a30; horizontal-alignment: center; overflow: elide; }
                Rectangle {
                    x: 5px * root.s; y: 6px * root.s; width: 39px * root.s; height: 26px * root.s;
                    border-radius: 5px * root.s; border-width: 1px * root.s; border-color: #808891; background: @linear-gradient(180deg, #d9e0e5, #99a3af);
                    Image { source: @image-url("../assets/icons/chevron-left.svg"); colorize: #fff; x: 14px * root.s; y: 6px * root.s; width: 10px * root.s; height: 14px * root.s; }
                    TouchArea { clicked => { root.command("back"); keyboard.focus(); } }
                }
            }
            library := LibraryView {
                visible: root.screen == 1 || root.screen == 3 || root.screen == 5 || root.screen == 6 || root.screen == 7 || root.screen == 8;
                enabled: (root.screen == 1 || root.screen == 3 || root.screen == 5 || root.screen == 6 || root.screen == 7 || root.screen == 8) && !root.reference-open && !root.shortcut-editor-open && !root.deepseek-settings-open && !root.genius-preview-open && !root.playlist-editor-open;
                y: (root.artwork-list || root.playlist-list || root.playlist-content ? 26px : 64px) * root.s; height: 432px * root.s - self.y; s: root.s;
                playlist-list: root.playlist-list; playlist-content: root.playlist-content;
                edit-playlist => { root.command("edit_playlist"); keyboard.focus(); }
                compact-title: root.screen == 5 || root.screen == 6 || root.screen == 7 || root.screen == 8; rows: root.rows; selected: root.selected; search: root.screen == 3;
                text-font-family: root.ui-font-family;
                search-text <=> root.search-text; scroll-y <=> root.list-scroll-y;
                activated(index) => { root.item-clicked(index); if !root.playlist-editor-open { keyboard.focus(); } }
                edited(text) => { root.query-changed(text); }
            }
            if root.screen == 4: Text { y: 100px * root.s; height: 250px * root.s; text: root.screen-title + "\n\n" + I18n.tr("This app is not available yet.") + "\n" + I18n.tr("Press Shift + H to return Home."); font-size: 14px * root.s; color: #666; horizontal-alignment: center; vertical-alignment: center; }
            now-playing := NowPlayingView {
                visible: root.screen == 2; y: 26px * root.s; height: 406px * root.s; s: root.s;
                navigation-enabled: root.screen == 2 && !root.reference-open && !root.shortcut-editor-open && !root.deepseek-settings-open && !root.genius-preview-open && !root.playlist-editor-open;
                selected: root.selected; selection-visible: root.keyboard-navigation; playing: root.playing; has-track: root.has-track;
                title: root.track-title; artist: root.track-artist; album: root.track-album; artwork: root.artwork;
                volume: root.volume; muted: root.muted; progress: root.progress; elapsed: root.elapsed; duration: root.duration; track-count: root.track-count;
                shuffle: root.shuffle; repeat-mode: root.repeat-mode;
                overlay-visible: root.overlay-visible; lyrics-visible: root.lyrics-visible; lyric-lines: root.lyric-lines; active-lyric: root.active-lyric;
                romaji-lines: root.romaji-lines; romaji-visible: root.romaji-visible;
                translated-lines: root.translated-lines; translation-visible: root.translation-visible;
                lyric-scroll-y <=> root.lyric-scroll-y;
                activated(index) => { root.item-clicked(index); keyboard.focus(); }
                toggle-overlay => { root.command("toggle_overlay"); keyboard.focus(); }
                genius-requested => { root.open-genius-preview(); }
                seek-changed(value) => { root.seek-changed(value); }
                volume-changed(value) => { root.volume-changed(value); }
                back => { root.command("back"); keyboard.focus(); }
            }
            }
        }
        video-device := VideoDeviceFrame {
            visible: root.screen == 9;
            x: 0px; y: 0px; width: keyboard.width; height: keyboard.height;
            device-mode: root.device-mode; landscape: root.video-landscape;
            home => { root.command("home"); keyboard.focus(); }
            VideoView {
                x: 0px; y: 0px; width: video-device.display-width; height: video-device.display-height; s: video-device.scale;
                frame: root.video-frame; title: root.video-title;
                playing: root.playing; controls-visible: root.video-overlay;
                selection-visible: root.keyboard-navigation; selected: root.selected;
                progress: root.progress; elapsed: root.elapsed; remaining: root.remaining;
                volume: root.volume; muted: root.muted;
                command(name) => { root.command(name); keyboard.focus(); }
                seek-changed(value) => { root.seek-changed(value); }
                volume-changed(value) => { root.volume-changed(value); }
            }
        }
        if root.shortcut-editor-open: ShortcutEditor {
            x: root.screen == 9 ? video-device.display-x : display.x; y: root.screen == 9 ? video-device.display-y : display.y; width: root.screen == 9 ? video-device.display-width : display.width; height: root.screen == 9 ? video-device.display-height : display.height;
            s: root.s; title: root.shortcut-title; keys: root.shortcut-keys;
            message: root.shortcut-message; recording: root.shortcut-recording;
            command(name) => { root.shortcut-command(name); }
        }
        genius-preview := GeniusPreview {
            visible: root.genius-preview-open;
            x: root.screen == 9 ? video-device.display-x : display.x; y: root.screen == 9 ? video-device.display-y : display.y; width: root.screen == 9 ? video-device.display-width : display.width; height: root.screen == 9 ? video-device.display-height : display.height;
            s: root.s; seed-title: root.genius-seed-title; seed-artist: root.genius-seed-artist; seed-available: root.genius-seed-available;
            songs: root.genius-songs; message: root.genius-message; busy: root.genius-busy;
            command(name) => { root.genius-action(name); }
        }
        playlist-editor := PlaylistEditor {
            x: root.screen == 9 ? video-device.display-x : display.x; y: root.screen == 9 ? video-device.display-y : display.y; width: root.screen == 9 ? video-device.display-width : display.width; height: root.screen == 9 ? video-device.display-height : display.height;
            s: root.s; open: root.playlist-editor-open; editing: root.playlist-editing; name <=> root.playlist-name;
            candidates: root.playlist-candidates; draft: root.playlist-draft; persisted: root.playlist-persisted;
            library-loading: root.playlist-library-loading; saving: root.playlist-saving;
            message: root.playlist-message;
            command(name, id) => { root.playlist-action(name, id); }
        }
        deepseek-dialog := DeepSeekSettings {
            x: root.screen == 9 ? video-device.display-x : display.x; y: root.screen == 9 ? video-device.display-y : display.y; width: root.screen == 9 ? video-device.display-width : display.width; height: root.screen == 9 ? video-device.display-height : display.height;
            s: root.s; open: root.deepseek-settings-open; key-configured: root.deepseek-key-configured;
            message: root.deepseek-message; api-key <=> root.deepseek-api-key; model <=> root.deepseek-model;
            command(name) => { root.deepseek-command(name); }
        }
        // Status stays inside the display; the window has no surrounding panel or footer.
        if root.notice != "" && root.notice != "Ready" && !root.deepseek-settings-open && !root.genius-preview-open && !root.playlist-editor-open: Rectangle {
            x: (root.screen == 9 ? video-device.display-x : display.x) + 4px * root.s; y: root.screen == 9 ? video-device.display-y + video-device.display-height - 24px * root.s : display.y + (root.screen == 2 ? 296px : 408px) * root.s;
            width: (root.screen == 9 ? video-device.display-width : display.width) - 8px * root.s; height: 20px * root.s; background: #222d;
            Text { x: 5px * root.s; width: parent.width - 10px * root.s; text: root.notice; color: white; font-size: 10px * root.s; overflow: elide; vertical-alignment: center; }
        }
        if root.reference-open: Rectangle {
            background: #0008;
            TouchArea { clicked => { root.command("close_shortcuts"); } }
            Rectangle {
                x: 12px; y: 16px; width: parent.width - 24px; height: parent.height - 32px;
                background: #f4f5f6; border-radius: 6px; border-width: 1px; border-color: #899098;
                Text { x: 16px; y: 10px; height: 24px; text: I18n.tr("Keyboard Shortcuts"); font-size: 18px; font-weight: 700; color: #222; }
                Text { x: parent.width - 38px; y: 10px; width: 26px; height: 24px; text: "×"; font-size: 22px; color: #555; horizontal-alignment: center; TouchArea { clicked => { root.command("close_shortcuts"); } } }
                Text { x: 16px; y: 40px; width: parent.width - 32px; height: 64px; text: I18n.tr("Shortcuts pause while editing search.\nEnter / Escape returns focus to results.\nDefaults: H/J/K/L = back/down/up/open.\nY: lyrics. Shift + H: Home."); font-size: 11px; color: #666; }
                Flickable {
                    x: 12px; y: 112px; width: parent.width - 24px; height: parent.height - 126px;
                    content-height: root.shortcuts.length * 46px;
                    for shortcut[index] in root.shortcuts: Rectangle {
                        y: index * 46px; height: 46px;
                        background: mod(index, 2) == 0 ? #fff : #eef0f2;
                        Text { x: 8px; y: 4px; height: 12px; text: shortcut.category; color: #697785; font-size: 9px; }
                        Text { x: 8px; y: 19px; height: 22px; width: parent.width - 138px; text: shortcut.title; font-size: 11px; color: #222; overflow: elide; }
                        Text { x: parent.width - 122px; width: 114px; text: shortcut.keys; horizontal-alignment: right; vertical-alignment: center; color: #30649c; font-size: 11px; }
                    }
                }
            }
        }
    }
}
