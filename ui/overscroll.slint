import { BackScroll } from "back-scroll.slint";
import { ElasticPhysics } from "overscroll-physics.slint";

// Slint TouchArea drops native wheel phases; the window event observer supplies them.
export global WheelGesture {
    in-out property <bool> active: false;
}

// Shared, allocation-free one-axis elastic motion in logical pixels.
// Only the visual position may leave the bounds; consumers persist bounded-position.
export component ElasticAxis inherits Rectangle {
    in property <length> minimum: 0px;
    in property <length> maximum: 0px;
    in property <length> extent: 240px;
    in property <bool> enabled: true;
    // B is selected; A/C remain available to the development harness only.
    in property <int> physics-configuration: 1;
    out property <length> position: 0px;
    out property <length> bounded-position: clamp(root.position, root.minimum, root.maximum);
    out property <length> overshoot: root.position - root.bounded-position;
    out property <bool> active: root.held || root.wheeling || clock.running;
    out property <float> motion-velocity: root.velocity;
    private property <bool> held;
    private property <bool> wheeling;
    private property <bool> native-wheel-active: WheelGesture.active;
    private property <float> velocity;
    private property <duration> last-time;
    private property <duration> frame-time;
    private property <length> limit: max(1px, root.extent * 0.32);
    width: 0px; height: 0px;
    physics := ElasticPhysics { configuration: root.physics-configuration; }

    // d*0.55/(1 + d*0.55/L): slope falls continuously towards zero.
    pure function rubber(distance: length) -> length {
        return physics.rubber(distance, root.limit);
    }
    pure function uncompress(distance: length) -> length {
        return physics.uncompress(distance, root.limit);
    }
    public function reset(value: length) {
        clock.stop(); wheel-end.stop(); root.held = false; root.wheeling = false; root.velocity = 0;
        root.position = clamp(value, root.minimum, root.maximum);
    }
    public function begin() {
        clock.stop(); wheel-end.stop(); root.wheeling = false; root.velocity = 0; root.held = true;
        root.last-time = animation-tick();
    }
    function displace(delta: length) {
        let boundary = root.bounded-position;
        let raw = boundary + root.uncompress(root.position - boundary) + delta;
        let bound = clamp(raw, root.minimum, root.maximum);
        root.position = bound + root.rubber(raw - bound);
    }
    public function drag(delta: length) {
        if !root.enabled { return; }
        if !root.held { root.begin(); }
        let before = root.position;
        root.displace(delta);
        let elapsed = (animation-tick() - root.last-time) / 1s;
        if elapsed > 0 && elapsed < 0.1 {
            root.velocity = 0.35 * root.velocity + 0.65 * ((root.position - before) / 1px) / max(0.008, elapsed);
        }
        root.last-time = animation-tick();
    }
    public function release() {
        root.held = false;
        if animation-tick() - root.last-time > 100ms { root.velocity = 0; }
        root.start-clock();
    }
    public function wheel(delta: length) {
        if !root.enabled { return; }
        clock.stop(); root.held = false; root.wheeling = true; root.velocity = 0;
        root.displace(delta);
        // Input owns the visual position until release. Never run the spring
        // against incoming deltas; use a short fallback for phase-less wheels.
        if root.native-wheel-active { wheel-end.stop(); }
        else { wheel-end.start(); wheel-end.restart(); }
    }
    function start-clock() {
        root.frame-time = animation-tick(); clock.start(); clock.restart();
    }
    changed enabled => { if !root.enabled { root.reset(root.bounded-position); } }
    changed minimum => { root.reset(root.bounded-position); }
    changed maximum => { root.reset(root.bounded-position); }
    changed extent => { root.reset(root.bounded-position); }
    changed physics-configuration => { root.reset(root.bounded-position); }
    changed native-wheel-active => {
        if root.wheeling {
            wheel-end.stop();
            if root.native-wheel-active { clock.stop(); }
            else { wheel-end.start(); wheel-end.restart(); }
        }
    }
    wheel-end := Timer {
        // Cover the native finger-end -> momentum-start handoff as well as
        // detecting the end of a phase-less wheel burst.
        interval: 32ms; running: false;
        triggered => {
            self.stop();
            if !root.native-wheel-active { root.start-clock(); }
        }
    }
    clock := Timer {
        interval: 16ms; running: false;
        triggered => {
            let elapsed = (animation-tick() - root.frame-time) / 1s;
            let dt = clamp(elapsed, 0.001, 0.032);
            root.frame-time = animation-tick();
            let offset = root.overshoot / 1px;
            if abs(offset) > 0.001 {
                // A preserves the original integration and absolute-position
                // arithmetic. B/C consume elapsed spring time analytically.
                let state = physics.spring(offset, root.velocity, root.physics-configuration == 0 ? dt : max(0.001, elapsed));
                root.velocity = state.velocity;
                let next = root.physics-configuration == 0 ? root.position + root.velocity * dt * 1px : root.bounded-position + state.offset * 1px;
                // Settle at the boundary without oscillating into the list.
                if (next - root.bounded-position) * offset <= 0px {
                    root.position = root.bounded-position; root.velocity = 0;
                } else { root.position = next; }
            } else {
                root.velocity = root.velocity / (1 + 5 * dt);
                root.displace(root.velocity * dt * 1px);
            }
            if abs(root.overshoot) < 0.1px && abs(root.velocity) < 3 {
                root.position = root.bounded-position; root.velocity = 0; root.wheeling = false; self.stop();
            }
        }
    }
}

// Keep Flickable's viewport, clipping and public content coordinates. Slint
// 1.18 clamps native pan/fling before exposing it, so a directional recognizer
// supplies deltas to ElasticAxis while taps still reach the existing children.
export component ElasticFlickable inherits Rectangle {
    in property <bool> back-enabled: false;
    in property <bool> touch-navigation: false;
    in property <bool> forward-enabled: false;
    in property <int> navigation-generation;
    in property <float> s: 1;
    in property <bool> enabled: true;
    in property <length> content-height;
    in-out property <length> content-y;
    in property <duration> follow-duration: 0ms;
    callback back;
    // Content coordinate at the original touch, never the row crossed later.
    callback forward(length);
    callback can-forward(length) -> bool;
    callback tapped(length);
    out property <length> navigation-offset: root.navigation-shift;
    out property <bool> touch-pressed;
    out property <length> pressed-content-y: mobile-touch.content-start-y;
    out property <length> overshoot: motion.overshoot;
    out property <length> visual-position: viewport.content-y + motion.overshoot;
    out property <bool> user-interacting: motion.active;
    private property <length> accumulated-x;
    private property <length> navigation-shift;
    private property <bool> navigating;
    animate navigation-shift { duration: root.navigating ? 0ms : 160ms; easing: ease-out; }
    public function cancel-motion() { pan.cancel(); mobile-touch.active = false; mobile-touch.axis = 0; root.touch-pressed = false; motion.reset(root.content-y); root.accumulated-x = 0px; root.navigating = false; root.navigation-shift = 0px; back-timeout.stop(); }
    function interrupt-follow() {
        // A lyric highlight may still be animating towards its canonical row.
        // Start new input at the rendered position, rather than that target.
        if abs(viewport.content-y - motion.bounded-position) > 0.1px {
            motion.reset(viewport.content-y);
        }
    }
    back-timeout := Timer { interval: 500ms; running: false; triggered => { root.accumulated-x = 0px; self.stop(); } }
    clip: true;
    motion := ElasticAxis {
        minimum: min(0px, root.height - root.content-height);
        extent: root.height; enabled: root.enabled;
        changed bounded-position => { root.content-y = self.bounded-position; }
    }
    changed content-y => {
        if abs(root.content-y - motion.bounded-position) > 0.01px {
            motion.reset(root.content-y);
            root.content-y = motion.bounded-position;
        }
    }
    changed height => { motion.reset(root.content-y); root.content-y = motion.bounded-position; }
    changed width => { motion.reset(root.content-y); }
    changed content-height => { motion.reset(root.content-y); root.content-y = motion.bounded-position; }
    changed enabled => { if !root.enabled { root.cancel-motion(); } }
    changed navigation-generation => { root.cancel-motion(); }
    // A small live displacement makes the committed direction visible before
    // release. Only mobile opts in; the desktop wheel and physics stay shared.
    if root.touch-navigation: Rectangle {
        visible: abs(root.navigation-shift) > 0.1px;
        background: #dbe4ec;
        Image {
            x: root.navigation-shift >= 0px ? 12px * root.s : root.width - self.width - 12px * root.s;
            y: clamp(mobile-touch.pressed-y - self.height / 2, 8px, root.height - self.height - 8px);
            width: 12px * root.s; height: 20px * root.s;
            source: root.navigation-shift >= 0px ? @image-url("../assets/icons/chevron-left.svg") : @image-url("../assets/icons/chevron-right.svg");
            colorize: #52728d;
        }
    }
    pan := SwipeGestureHandler {
        x: 0px; y: 0px; width: root.width; height: root.height;
        enabled: root.enabled && !root.touch-navigation;
        handle-swipe-up: true; handle-swipe-down: true;
        handle-swipe-right: root.back-enabled;
        private property <length> previous-y;
        private property <bool> tracking;
        private property <bool> horizontal;
        moved => {
            let dx = self.current-position.x - self.pressed-position.x;
            let dy = self.current-position.y - self.pressed-position.y;
            if self.horizontal { return; }
            if !self.tracking {
                // Lock the axis once, rather than switching during a reversal.
                if abs(dx) > abs(dy) { self.horizontal = true; return; }
                root.interrupt-follow();
                self.previous-y = self.pressed-position.y;
                self.tracking = true; motion.begin();
                root.accumulated-x = 0px; back-timeout.stop();
            }
            motion.drag(self.current-position.y - self.previous-y);
            self.previous-y = self.current-position.y;
        }
        swiped => {
            let dx = self.current-position.x - self.pressed-position.x;
            let dy = self.current-position.y - self.pressed-position.y;
            if self.horizontal && root.back-enabled && dx > 24px * root.s && dx > 1.5 * abs(dy) { root.back(); }
            self.tracking = false; self.horizontal = false; motion.release();
        }
        cancelled => { self.tracking = false; self.horizontal = false; motion.release(); }
        viewport := Flickable {
            x: root.navigation-shift; y: 0px; width: root.width; height: root.height;
            interactive: false;
            content-width: root.width;
            content-height: max(self.height, root.content-height);
            content-y: clamp(root.content-y, min(0px, root.height - root.content-height), 0px);
            animate content-y { duration: motion.active ? 0ms : root.follow-duration; easing: ease-out; }
            TouchArea {
                x: 0px; y: -viewport.content-y;
                width: root.width; height: root.height;
                scroll-event(event) => {
                    if abs(event.delta-x) > 1.5 * abs(event.delta-y) {
                        if !root.back-enabled { return reject; }
                        BackScroll.activity();
                        if BackScroll.consumed {
                            root.accumulated-x = 0px; back-timeout.stop(); return accept;
                        }
                        if root.enabled {
                            root.accumulated-x = max(0px, root.accumulated-x + event.delta-x);
                            back-timeout.start(); back-timeout.restart();
                            if root.accumulated-x > 32px * root.s {
                                root.accumulated-x = 0px; back-timeout.stop();
                                BackScroll.consumed = true; BackScroll.activity(); root.back();
                            }
                        }
                        return accept;
                    }
                    root.accumulated-x = 0px; back-timeout.stop();
                    if root.enabled { root.interrupt-follow(); motion.wheel(event.delta-y); }
                    accept
                }
                Rectangle {
                    x: 0px; y: viewport.content-y + motion.overshoot;
                    width: root.width; height: max(root.height, root.content-height);
                    @children
                }
            }
        }
    }
    // Mobile uses one immediate tap/pan owner. SwipeGestureHandler deliberately
    // delays child presses by 100ms, which makes list taps feel unresponsive.
    // Keeping taps here also prevents a completed swipe from playing its row.
    mobile-touch := TouchArea {
        enabled: root.enabled && root.touch-navigation;
        x: 0px; y: 0px; width: root.width; height: root.height;
        property <bool> active;
        property <int> axis; // 0 undecided, 1 horizontal, 2 vertical
        property <length> content-start-y;
        property <bool> forward-allowed;
        property <length> previous-x;
        property <length> previous-y;
        property <duration> previous-time;
        property <float> horizontal-velocity;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.interrupt-follow(); motion.reset(root.content-y);
                self.active = true; self.axis = 0;
                self.content-start-y = self.pressed-y - root.visual-position;
                self.forward-allowed = root.forward-enabled && root.can-forward(self.content-start-y);
                self.previous-x = self.mouse-x; self.previous-y = self.mouse-y;
                self.previous-time = animation-tick(); self.horizontal-velocity = 0;
                root.touch-pressed = true;
            } else if event.kind == PointerEventKind.move && self.active {
                let dx = self.mouse-x - self.pressed-x;
                let dy = self.mouse-y - self.pressed-y;
                if self.axis == 0 {
                    if max(abs(dx), abs(dy)) < 8px { return; }
                    if abs(dx) > 1.2 * abs(dy) { self.axis = 1; root.navigating = true; }
                    else if abs(dy) > 1.2 * abs(dx) { self.axis = 2; motion.begin(); }
                    else { root.touch-pressed = false; return; }
                    root.touch-pressed = false;
                }
                if self.axis == 1 {
                    let dt = (animation-tick() - self.previous-time) / 1s;
                    if dt > 0 && dt < 0.15 { self.horizontal-velocity = ((self.mouse-x - self.previous-x) / 1px) / max(0.008, dt); }
                    let allowed = dx >= 0px ? root.back-enabled : self.forward-allowed;
                    root.navigation-shift = allowed ? clamp(dx * 0.7, -root.width * 0.42, root.width * 0.42) : 0px;
                } else { motion.drag(self.mouse-y - self.previous-y); }
                self.previous-x = self.mouse-x; self.previous-y = self.mouse-y;
                self.previous-time = animation-tick();
            } else if event.kind == PointerEventKind.up && self.active {
                let dx = self.mouse-x - self.pressed-x;
                let dy = self.mouse-y - self.pressed-y;
                let recent = animation-tick() - self.previous-time < 100ms;
                let commit = abs(dx) >= max(44px, root.width * 0.22) || (recent && abs(dx) >= 24px && self.horizontal-velocity * (dx >= 0px ? 1 : -1) > 550);
                let forward = self.axis == 1 && dx < 0px && self.forward-allowed && commit;
                let back = self.axis == 1 && dx > 0px && root.back-enabled && commit;
                let tap = self.axis == 0 && max(abs(dx), abs(dy)) < 8px;
                if self.axis == 2 { motion.release(); }
                self.active = false; self.axis = 0; root.touch-pressed = false;
                root.navigating = false; root.navigation-shift = 0px;
                if forward { root.forward(self.content-start-y); }
                else if back { root.back(); }
                else if tap { root.tapped(self.content-start-y); }
            } else if event.kind == PointerEventKind.cancel {
                if self.axis == 2 { motion.release(); }
                self.active = false; self.axis = 0; root.touch-pressed = false;
                root.navigating = false; root.navigation-shift = 0px;
            }
        }
    }
}
