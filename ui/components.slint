// NanoSlider's drag mapping is adapted from Slint's MIT-licensed fancy_demo Slider.
// Copyright © SixtyFPS GmbH <info@slint.dev>. See licenses/slint-examples-MIT.txt.
import { I18n } from "i18n.slint";

export component NanoActionButton inherits Rectangle {
    in property <float> s: 1;
    in property <string> label;
    in property <bool> primary;
    in property <bool> modern: false;
    in property <bool> enabled: true;
    in property <length> text-size: 12px * root.s;
    callback clicked;
    height: 32px * root.s;
    border-radius: (root.modern ? 10px : 5px) * root.s; border-width: (root.modern ? 0px : 1px) * root.s;
    border-color: root.primary ? #255e99 : #9ba3ab;
    background: root.modern ? (!root.enabled ? #e2e6ec : root.primary ? (touch.pressed ? #0061d0 : #007aff) : (touch.pressed ? #d7e6fc : #ffffffe0)) : (!root.enabled ? #d9dee3 : (touch.pressed ? #8795a4 : (root.primary ? @linear-gradient(180deg, #619ed7, #2b6caf) : @linear-gradient(180deg, #fff, #d7dce2))));
    Text { text: I18n.tr(root.label); font-family: root.modern ? "Helvetica Neue" : ""; font-size: root.text-size; font-weight: 600; color: !root.enabled ? #88929d : root.modern ? (root.primary ? white : #007aff) : (root.primary ? white : #263441); horizontal-alignment: center; vertical-alignment: center; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.modern ? pointer : default; clicked => { root.clicked(); } }
}

// Scale the rounded caps with the UI, stretching only the straight center.
// SVG skins also preserve rounded gradients in the software renderer.
component SliderRail inherits Rectangle {
    in property <float> s: 1;
    in property <bool> filled;
    private property <image> skin: root.filled ? @image-url("../assets/icons/slider-track-filled.svg") : @image-url("../assets/icons/slider-track.svg");
    height: 8px * root.s;
    background: transparent;
    Rectangle {
        x: 4px * root.s; width: max(0px, root.width - 8px * root.s); height: root.height;
        background: root.filled ? @linear-gradient(180deg, #484c51, #9a9da2 62%, #d4d6d9) : @linear-gradient(180deg, #08090b, #292c30 62%, #73767b);
        Rectangle {
            y: 1px * root.s; height: parent.height - 2px * root.s; width: parent.width;
            background: root.filled ? @linear-gradient(180deg, #acafb3, #d9dbde 30%, #bfc2c6 68%, #93979c) : @linear-gradient(180deg, #111316, #292c30 48%, #4e5155);
        }
    }
    // Clip whole SVGs rather than source pixels to keep fractional UI scales safe.
    Rectangle {
        x: 0px; width: 4px * root.s; height: root.height; clip: true; background: transparent;
        Image { x: 0px; width: 16px * root.s; height: root.height; source: root.skin; image-fit: fill; }
    }
    Rectangle {
        x: root.width - 4px * root.s; width: 4px * root.s; height: root.height; clip: true; background: transparent;
        Image { x: -12px * root.s; width: 16px * root.s; height: root.height; source: root.skin; image-fit: fill; }
    }
}

export component NanoSlider inherits Rectangle {
    in property <float> s: 1;
    in property <float> value;
    in property <bool> selected;
    in property <bool> enabled: true;
    in property <bool> touch-mode: false;
    in property <length> handle-size: 22px * root.s;
    callback changed(float);
    height: 22px * s;
    background: transparent;
    opacity: root.enabled ? 1 : 0.5;
    // Dark recessed groove and silver fill follow the original nano controls.
    SliderRail {
        x: 0px; width: root.width;
        y: (parent.height - self.height) / 2; s: root.s;
    }
    if root.value > 0: SliderRail {
        x: 0px; y: (parent.height - self.height) / 2;
        width: root.value >= 1 ? root.width : handle.x + handle.width / 2;
        s: root.s; filled: true;
    }
    handle := Rectangle {
        width: root.handle-size; height: self.width;
        y: (parent.height - self.height) / 2;
        x: (root.width - self.width) * clamp(root.value, 0, 1);
        border-radius: self.width / 2;
        background: transparent;
        Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: @image-url("../assets/icons/slider-knob.svg"); image-fit: contain; }
        if touch.pressed: Rectangle { x: 1px * root.s; y: 1px * root.s; width: parent.width - 2px * root.s; height: self.width; border-radius: self.width / 2; background: #0001; }
        if root.selected && root.enabled: Rectangle {
            x: -2px * root.s; y: -2px * root.s;
            width: parent.width + 4px * root.s; height: self.width;
            border-radius: self.width / 2; border-width: 1.5px * root.s;
            border-color: #65b9ff; background: transparent;
        }
    }
    touch := TouchArea {
        x: 0px; y: root.touch-mode ? (root.height - max(root.height, 44px)) / 2 : 0px;
        width: root.width; height: root.touch-mode ? max(root.height, 44px) : root.height;
        enabled: root.enabled;
        property <float> pressed-value;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                self.pressed-value = clamp((self.mouse-x - handle.width / 2) / (root.width - handle.width), 0, 1);
                root.changed(self.pressed-value);
            }
        }
        moved => { if self.pressed { root.changed(clamp(self.pressed-value + (self.mouse-x - self.pressed-x) / (root.width - handle.width), 0, 1)); } }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> selected;
    in property <bool> active;
    in property <float> s: 1;
    in property <bool> flat;
    in property <length> icon-size: min(root.width * 0.43, root.height * 0.5);
    callback clicked;
    background: touch.pressed ? #0005 : (root.flat ? transparent : @linear-gradient(180deg, #444, #242424));
    border-width: root.selected ? 2px * s : 0px; border-color: #65b9ff;
    Image {
        source: root.icon; colorize: root.active ? #94eeff : #f3f6ff;
        width: root.icon-size; height: root.icon-size;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; image-fit: contain;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

export component AppIcon inherits Rectangle {
    in property <float> s: 1;
    in property <string> label;
    in property <image> icon;
    in property <color> tint;
    in property <bool> full-artwork;
    in property <bool> selected;
    callback clicked;
    width: 92px * s; height: 104px * s; background: transparent;
    Rectangle {
        x: (parent.width - self.width) / 2; y: 0px; width: 72px * root.s; height: self.width; border-radius: self.width / 2;
        background: root.full-artwork ? transparent : @linear-gradient(180deg, root.tint.brighter(55%) 0%, root.tint.darker(20%) 49%, root.tint 52%, root.tint.brighter(15%) 100%);
        border-width: (root.full-artwork ? 0px : (root.selected ? 3px : 1px)) * root.s; border-color: root.selected ? #fff : root.tint.brighter(75%);
        drop-shadow-blur: 3px * root.s; drop-shadow-offset-y: 2px * root.s; drop-shadow-color: #0008;
        if root.full-artwork: Image { source: root.icon; x: 0px; y: 0px; width: parent.width; height: parent.height; image-fit: contain; }
        if !root.full-artwork: Image { source: root.icon; colorize: #fff; x: 18px * root.s; y: 18px * root.s; width: 36px * root.s; height: 36px * root.s; image-fit: contain; }
        if !root.full-artwork: Rectangle { x: 9px * root.s; y: 5px * root.s; width: 54px * root.s; height: 24px * root.s; border-radius: 16px * root.s; background: @linear-gradient(180deg, #ffffff90, #ffffff00); }
    }
    if root.selected: Rectangle { x: 8px * root.s; y: -2px * root.s; width: 76px * root.s; height: self.width; border-radius: self.width / 2; background: transparent; border-color: white; border-width: 2px * root.s; }
    Text { y: 78px * root.s; height: 20px * root.s; text: root.label; color: white; font-size: 13px * root.s; font-weight: root.selected ? 700 : 500; horizontal-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}
