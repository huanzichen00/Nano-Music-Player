import { I18n } from "i18n.slint";
import { NanoActionButton } from "components.slint";
import { DesktopStyle, DesktopSurface, DesktopCard, SurfaceText } from "desktop-surfaces.slint";
component EditorButton inherits NanoActionButton { modern: true; height: 34px * self.s; }

export component ShortcutEditor inherits Rectangle {
    in property <float> s;
    in property <string> title;
    in property <string> keys;
    in property <string> message;
    in property <bool> recording;
    callback command(string);
    background: #0004;
    TouchArea {} // Keep pointer input inside the modal.
    DesktopSurface {
        s: root.s;
        x: 10px * root.s; y: (parent.height - self.height) / 2;
        width: parent.width - 20px * root.s; height: 310px * root.s;
        DesktopCard { x: 8px * root.s; y: 55px * root.s; width: parent.width - 16px * root.s; height: 43px * root.s; s: root.s; }
        SurfaceText { x: 12px * root.s; y: 14px * root.s; width: parent.width - 24px * root.s; height: 40px * root.s; text: root.title; font-size: 16px * root.s; font-weight: 700; color: DesktopStyle.text; wrap: word-wrap; }
        SurfaceText { x: 12px * root.s; y: 57px * root.s; width: parent.width - 24px * root.s; height: 42px * root.s; text: root.keys; font-size: 12px * root.s; font-weight: 600; color: DesktopStyle.accent; wrap: word-wrap; }
        Rectangle {
            x: 12px * root.s; y: 105px * root.s; width: parent.width - 24px * root.s; height: 60px * root.s;
            background: root.recording ? #deebff : #ffffffe0; border-radius: 10px * root.s;
            SurfaceText { x: 8px * root.s; width: parent.width - 16px * root.s; text: root.message; font-size: 12px * root.s; color: #36475b; wrap: word-wrap; vertical-alignment: center; }
        }
        if !root.recording: Rectangle {
            x: 12px * root.s; y: 178px * root.s; width: parent.width - 24px * root.s; height: 80px * root.s;
            EditorButton { x: 0px; y: 0px; width: (parent.width - 8px * root.s) / 2; s: root.s; label: "Replace keys"; primary: true; clicked => { root.command("replace"); } }
            EditorButton { x: (parent.width + 8px * root.s) / 2; y: 0px; width: (parent.width - 8px * root.s) / 2; s: root.s; label: "Add key"; clicked => { root.command("add"); } }
            EditorButton { x: 0px; y: 42px * root.s; width: (parent.width - 8px * root.s) / 2; s: root.s; label: "Remove keys"; clicked => { root.command("clear"); } }
            EditorButton { x: (parent.width + 8px * root.s) / 2; y: 42px * root.s; width: (parent.width - 8px * root.s) / 2; s: root.s; label: "Default keys"; clicked => { root.command("restore"); } }
        }
        if root.recording: SurfaceText { x: 14px * root.s; y: 180px * root.s; width: parent.width - 28px * root.s; height: 66px * root.s; text: I18n.tr("Letters, arrows, function keys\nand modifier combinations.\nChanges save automatically."); font-size: 11px * root.s; color: DesktopStyle.secondary; horizontal-alignment: center; vertical-alignment: center; }
        EditorButton { x: 12px * root.s; y: 265px * root.s; width: parent.width - 24px * root.s; s: root.s; label: root.recording ? "Cancel recording" : "Done"; clicked => { root.command(root.recording ? "cancel" : "done"); } }
    }
}
